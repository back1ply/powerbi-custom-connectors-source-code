/**
 * DeltaTable FastCopy Module
 * This module provides functions to leverage delta tables generated by DW/Lakehouse and copy them to output Lakehouse.
 * The module includes functionality for:
 * 1. Detect that the source is a staging Lakehouse table or staging DW table.
 * 2. If so, parallel copy the parquet files for the delta table to the output lakehouse.
 * 3. Update the metadata for the copied parquet files.
 * 4. Update the Delta Log for the table.
**/
(cloud) => let
    Utils = try #shared[Utils] catch(e) => 
            error Diagnostics.Trace(TraceLevel.Error, [Name = "UtilsModuleLoadError", Data = []], e),
    OneLake.ContentsNonHierarchical = try #shared[OneLake.ContentsNonHierarchical] catch(e) => 
            error Diagnostics.Trace(TraceLevel.Error, [Name = "OneLakeModuleLoadError", Data = []], e),
    OneLake.BlobContents = try #shared[OneLake.BlobContents] catch(e) => 
            error Diagnostics.Trace(TraceLevel.Error, [Name = "OneLakeBlobModuleLoadError", Data = []], e),
    OneLake.Contents = try #shared[OneLake.Contents] catch(e) => 
            error Diagnostics.Trace(TraceLevel.Error, [Name = "OneLakeModuleLoadError", Data = []], e),
    OneLake.FileContents = try #shared[OneLake.FileContents] catch(e) => 
            error Diagnostics.Trace(TraceLevel.Error, [Name = "OneLakeModuleLoadError", Data = []], e),
    ListAction.ParallelExecute = try #shared[ListAction.ParallelExecute] catch(e) => 
            error Diagnostics.Trace(TraceLevel.Error, [Name = "ListActionModuleLoadError", Data = []], e),
    GetWarehouseDatabaseView = try #shared[GetWarehouseDatabaseView] catch(e) => 
            error Diagnostics.Trace(TraceLevel.Error, [Name = "GetWarehouseDatabaseViewModuleLoadError", Data = []], e),
    
    DWOnelakeFormat = "#{0}/#{1}/#{2}/Tables/dbo/#{3}",
    StagingLkOnelakeFormat = "#{0}/#{1}/#{2}/Tables/#{3}",
    LHOnelakeFormat = "#{0}/#{1}/#{2}",

    Function.Atomic = (n, f) => let f = Table.ViewFunction(f) in Value.ReplaceType(f, Value.Type(f) meta [Documentation.Name = n]),
    Lakehouse.TryDeltaTableFastCopy = (table) => try Lakehouse.DeltaTableFastCopy(table) otherwise null,
    Lakehouse.DeltaTableFastCopy = Function.Atomic("Lakehouse.DeltaTableFastCopy", (t) => error [
        Reason = Utils[NonPii]("Expression.Error"),
        Message = Utils[NonPii](Utils[Value.ToText](t, 5)),
        Detail = t
    ]),

    // TODO : Cache this result in FileCache.
    CheckIfDeltaLogPublishingIsEnabled = (sqlInstance, dwName) as logical =>
        let
            checkDeltaLogStatusQuery = Text.Format(
                "SELECT [name], [DATA_LAKE_LOG_PUBLISHING_DESC] FROM sys.databases WHERE [name] = ('#{0}')",
                {dwName}
            ),
            deltaLogPublishingEnabled = Value.NativeQuery(sqlInstance, checkDeltaLogStatusQuery)
        in
            Table.RowCount(deltaLogPublishingEnabled) > 0 and deltaLogPublishingEnabled[DATA_LAKE_LOG_PUBLISHING_DESC]?{0} = "AUTO",

    MaxOneLakeContentsRetryCount = 14,
    OneLakeContentsRetryDelay = #duration(0, 0, 0, 5),
    // When a table is written out to DW there can be upto a 1 min delay for it to be ready on OneLake. 
    // (Based on SLO of 1 min from DW team)
    // Retry onelake api call with a delay of 5 seconds, with a maximum retry count of 14 which results in a max retry duration 
    // of around 70 seconds.
    RetryOneLakeContents = (url as text) =>
        let
            retries = List.Generate(
                () => [i = 0, result = try Table.Buffer(OneLake.Contents(url)), shouldContinue = true],
                each [shouldContinue],
                each [
                    shouldContinue = [result][HasError]
                        and IsRetryableHttpErrorFromOneLake([result][Error])
                        and [i] < MaxOneLakeContentsRetryCount,
                    i = [i] + 1,
                    result = if shouldContinue then
                        Function.InvokeAfter(
                            () =>
                                Diagnostics.Trace(
                                    TraceLevel.Information,
                                    [Name = "DeltaTableFastCopy/RetryOneLakeContents", Data = [Attempt = Utils[NonPii](i)]],
                                    try Table.Buffer(OneLake.Contents(url))),
                            OneLakeContentsRetryDelay)
                    else
                        [result]
                ]),
            lastAttempt = List.Last(retries)
        in
            if lastAttempt[result][HasError] then error lastAttempt[result][Error] else lastAttempt[result][Value],

    // Retry on 404/503 (503 can happen as per telemetry)
    IsRetryableHttpErrorFromOneLake = (errorRecord) =>
        let
            httpStatusCode = errorRecord[Detail]?[HttpStatusCode]?
        in
            List.Contains({404, 503}, httpStatusCode),

    // Use StagingDW as an interim location to write data.
    GetSqlInstanceIfFolded = (t) =>
        let
            LiftTableReorderColumnExpression = (ast) =>
                if (ast[Kind] = "Invocation" and ast[Function][Value]? = Table.ReorderColumns)
                then ast[Arguments]{0}
                else ast,
            ExtractNativeQuerySource = (ast) =>
                if (ast[Kind] = "Invocation" and ast[Function][Value]? = Value.NativeQuery)
                then ast[Arguments]{0}
                else ast,
            ExtractSqlDataSource = (ast) =>
                if (ast[Kind] = "Invocation"
                    and ast[Function][Value]? = Sql.Database
                    and ast[Arguments]{0}?[Kind] = "Constant")
                then ast[Arguments]{0}[Value]
                else null,
            Expression = ExtractSqlDataSource(
                ExtractNativeQuerySource(
                    LiftTableReorderColumnExpression(
                        Value.Expression(Value.Optimize(t)))))
        in
            Expression,
    
    GetSqlInstanceForRowsToInsert = (input as table, dwServerInstance as table) => 
        GetSqlInstanceIfFolded(input) = GetSqlInstanceIfFolded(dwServerInstance),

    // Fabric DW / SQL Server identifiers (sysname) are limited to 128 characters.
    // The composed Staging DW table name (Version + "_" + source TableName) can exceed
    // this when the SqlName-encoded source table name is long, causing DW table creation
    // and the in-process cleanup (DropTableFromDWActions called via dropTableFromDWAction)
    // to fail. See MDSync.pqm's "TableNameTooLongFailure" for the same 128-char guard.
    MaxDWTableNameLength = 128,

    // Build the Staging DW table name from version + source table name.
    // - When the combined value fits within MaxDWTableNameLength, it is returned unchanged
    //   to preserve backward compatibility with markers / DW tables created before this fix.
    // - When it exceeds the limit, the value is truncated to exactly MaxDWTableNameLength.
    //   The 32-char GUID `version` prefix provides per-write uniqueness, and each
    //   GenerateDeltaTableFastCopyActions invocation operates on a single source table,
    //   so plain truncation is collision-safe within a write batch.
    // All callers that need to refer to the same DW table (creation, OneLake path lookup,
    // and in-process drop) MUST go through this helper so the names stay consistent.
    BuildStagingDWTableName = (version as text, tableName as text) as text =>
        let
            combined = version & "_" & tableName,
            combinedLength = Text.Length(combined)
        in
            if combinedLength <= MaxDWTableNameLength then
                combined
            else
                Diagnostics.Trace(
                    TraceLevel.Information,
                    [
                        Name = "DeltaTableFastCopy/StagingDWTableNameTruncated",
                        Data = [
                            OriginalLength = Utils[NonPii](Number.ToText(combinedLength)),
                            TruncatedLength = Utils[NonPii](Number.ToText(MaxDWTableNameLength))
                        ]
                    ],
                    Text.Start(combined, MaxDWTableNameLength)),
    
    // Use the fast egress path only if the number of parquet files in DW staging location are more than 1 (typically happens after a 1 million row mark)
    // or if the connector is making the staging choice, the number of rows is more than 1 million
    // (this might have to be revisited later.)
    ShouldUseFastEgressPath = (
        apiUrl as text,
        srcTable as table,
        deltaTableFastCopySupportInSource as record,
        options as record) as logical =>
        let
            result =
                if deltaTableFastCopySupportInSource[Source]? = "Lakehouse" then
                    Table.RowCount(srcTable) > 1000000
                else if deltaTableFastCopySupportInSource[Source]? = "Warehouse" then
                    // Warehouse-managed Delta tables can lag behind on OneLake, so retry like the rest of this module does.
                    try
                        let
                            oneLakeBaseUrl = Utils[GetOneLakeBaseUrl](cloud, Text.Contains(Text.Lower(apiUrl), "msit"), true),
                            oneLakeUrl = Text.Format(
                                DWOnelakeFormat,
                                {
                                    oneLakeBaseUrl,
                                    options[StagingWorkspaceId]?,
                                    options[StagingWarehouseId]?,
                                    deltaTableFastCopySupportInSource[TableName]
                                }
                            ),
                            onelakeContents = RetryOneLakeContents(oneLakeUrl),
                            filterDeltaLogAndMetadata = Table.SelectRows(
                                onelakeContents,
                                each not Text.Contains([Name], "_delta_log") and not Text.Contains([Name], "metadata")),
                            withNonHierarchicalContents = Table.AddColumn(
                                filterDeltaLogAndMetadata,
                                "NonHierarchicalContents",
                                each OneLake.ContentsNonHierarchical([Folder Path] & [Name])),
                            justNonHierarchicalContents = Table.Combine(withNonHierarchicalContents[NonHierarchicalContents]),
                            parquetFileCount = Table.RowCount(
                                Table.SelectRows(justNonHierarchicalContents, each [Extension] = ".parquet"))
                        in
                            Diagnostics.Trace(
                                TraceLevel.Information,
                                [
                                    Name = "DeltaTableFastCopy/ParquetFileCount", 
                                    Data = [ParquetFileCount = Utils[NonPii](parquetFileCount)]
                                ],
                                parquetFileCount > 1)
                    catch(e) =>
                        Diagnostics.Trace(
                            TraceLevel.Warning,
                            [
                                Name = "DeltaTableFastCopy/ParquetFileCount/Error",
                                Data = [Error = Utils[Value.ToText](e)]
                            ], false)
                else
                    false
        in
            Diagnostics.Trace(
                TraceLevel.Information,
                [
                    Name = "ShouldUseFastEgressPath/Result",
                    Data = [Result = Utils[NonPii](result)]
                ], result),


    WriteToDWActions = (
        tableName as text,
        input as table,
        warehouseId as text,
        workspaceId as text,
        baseUrl as text) =>
        let
            dwInstance = GetWarehouseDatabaseView(baseUrl, workspaceId, warehouseId, []),
            insertActions = Action.Sequence({
                TableAction.InsertRows(
                    dwInstance,
                    #table(
                        {"Item", "Schema", "Data"},
                        {{tableName, "dbo", input}})),
                Action.DoNothing
            })
        in
            insertActions,
        
    // Drop a table from the StagingDW.
    DropTableFromDWActions = (
        tableName as text,
        warehouseId as text,
        workspaceId as text,
        baseUrl as text) =>
        let
            dwInstance = GetWarehouseDatabaseView(baseUrl, workspaceId, warehouseId, []),
            deleteActions = Action.Sequence({
                TableAction.DeleteRows(
                    Table.SelectRows(dwInstance, each [Item] = tableName and [Schema] = "dbo")),
                Action.DoNothing
            })
        in
            deleteActions,
    
    GetDWDetailsForCleanUp = (input as text) =>
        let
            parts = Text.Split(input, "@"),
            tableName = parts{0},
            // ignore part{1} - its a marker
            workspaceId = parts{3},
            warehouseId = parts{2}
        in
            [TableName = tableName, WorkspaceId = workspaceId, WarehouseId = warehouseId],

    ShouldUseDeltaTableFastCopy = (apiUrl as text, input as table, options as record) =>
        let
            enableOptimizedCopy = options[EnableOptimizedCopyToLakehouse]? ?? false,
            stagingWarehouseId = options[StagingWarehouseId]?,
            dwInstance = GetWarehouseDatabaseView(apiUrl, options[StagingWorkspaceId]?, stagingWarehouseId, []),
            DeltaTableFastCopySupportInSource = Lakehouse.TryDeltaTableFastCopy(input),
            // If source is a Lakehouse, check if it can be folded to the StagingDW
            useFoldingCheckForDW = if DeltaTableFastCopySupportInSource[Source]? = "Lakehouse" then 
                GetSqlInstanceForRowsToInsert(input, dwInstance) 
            else 
                true
        in
            enableOptimizedCopy
            and DeltaTableFastCopySupportInSource <> null
            and DeltaTableFastCopySupportInSource[Enabled]? = true
            and useFoldingCheckForDW
            and ShouldUseFastEgressPath(apiUrl, input, DeltaTableFastCopySupportInSource, options),
    
    DeltaTableFastCopyDetails = (input as table) =>
        Lakehouse.DeltaTableFastCopy(input),
    
    GenerateDeltaTableFastCopyActions = (
        apiUrl as text,
        detailsForSourceOneLake as record,
        destinationDetails as record,
        deltaTableBeingModified as table,
        rowsToInsert as table) =>
        let
            oneLakeBaseUrl = Utils[GetOneLakeBaseUrl](cloud, Text.Contains(Text.Lower(apiUrl), "msit"), true),
            version = detailsForSourceOneLake[Version],
            tableNameInDW = if detailsForSourceOneLake[StageToDW] then 
                BuildStagingDWTableName(detailsForSourceOneLake[Version], detailsForSourceOneLake[TableName])
            else 
                detailsForSourceOneLake[TableName],
            finalSourceOneLakeFormat = if detailsForSourceOneLake[IsWarehouse] then DWOnelakeFormat else StagingLkOnelakeFormat,
            oneLakeUrl = Text.Format(
                finalSourceOneLakeFormat,
                {
                    oneLakeBaseUrl,
                    detailsForSourceOneLake[WorkspaceId],
                    if detailsForSourceOneLake[IsWarehouse] then
                        detailsForSourceOneLake[WarehouseId]
                    else
                        detailsForSourceOneLake[LakehouseId],
                    tableNameInDW
                }),
            onelakeContents = RetryOneLakeContents(oneLakeUrl),
            tableSchema = Table.Schema(deltaTableBeingModified),
            filterDeltaLogAndMetadata = Table.SelectRows(
                onelakeContents,
                each not Text.Contains([Name], "_delta_log") and not Text.Contains([Name], "metadata")),
            withNonHierarchicalContents = Table.AddColumn(
                filterDeltaLogAndMetadata,
                "NonHierarchicalContents",
                each OneLake.ContentsNonHierarchical([Folder Path] & [Name])),
            withCopyActions = (input) =>
                let
                    name = input[Name],
                    path = input[Folder Path],
                    source = Text.Format("#{0}#{1}", {path, name}),
                    target = Text.Format(
                        LHOnelakeFormat,
                        {
                            destinationDetails[OneLakeTableUrl],
                            destinationDetails[TableName],
                            input[Name] // File Name
                        }),
                    finalActions = Action.Sequence({
                        ValueAction.Replace(
                            OneLake.BlobContents(modifiedTarget),
                            OneLake.BlobContents(modifiedSource)),
                        Action.DoNothing
                    }),

                    // Replace .dfs. with .blob. to ensure put block works
                    modifiedTarget = ConvertDFSToBlobUrl(target),
                    modifiedSource = ConvertDFSToBlobUrl(source)
                in
                    () => Action.Sequence({finalActions, Action.DoNothing}),
            justNonHierarchicalContents = Table.Combine(withNonHierarchicalContents[NonHierarchicalContents]),
            withActions = Table.AddColumn(justNonHierarchicalContents, "Actions", withCopyActions),
            // store the list of copied parquet files in the state table so it can be retrieved for performing parquet metadata actions.
            storeDataInStateTable = State.DeltaTableFastCopyTableStoreActions(version, destinationDetails[TableName], withActions[Name]),

            readFileListFromStateTable = State.DeltaTableFastCopyTable(version & "_" & destinationDetails[TableName]),
            listOfFiles = Table.FromList(
                readFileListFromStateTable{0}[DeltaTableFastCopyDetails],
                Splitter.SplitByNothing(),
                {"FileName"}),
            
            withParquetMetdataActions = Table.AddColumn(
                listOfFiles,
                "ParquetMetadataActions",
                (file) => ParquetMetadataActions(
                    OneLake.BlobContents(
                        Text.Format(LHOnelakeFormat,
                        { 
                            ConvertDFSToBlobUrl(destinationDetails[OneLakeTableUrl]),
                            destinationDetails[TableName],
                            file[FileName]
                        })),
                    tableSchema[Name])
            ),
            withDeltaFixupActions = Table.AddColumn(
                listOfFiles,
                "DeltaFixupActions",
                (file) => UpdateDeltaLogWithFileReference(
                    deltaTableBeingModified,
                    OneLake.FileContents(
                        destinationDetails[OneLakeTableUrl] & "/" & destinationDetails[TableName] & "/" & file[FileName]))
            ),
            createDWTableAction = if detailsForSourceOneLake[StageToDW] then 
                WriteToDWActions(
                    tableNameInDW,
                    rowsToInsert,
                    detailsForSourceOneLake[WarehouseId],
                    detailsForSourceOneLake[WorkspaceId],
                    apiUrl)
                else 
                    Action.DoNothing,
            
            dropTableFromDWAction = if detailsForSourceOneLake[StageToDW] then
                DropTableFromDWActions(
                    tableNameInDW,
                    detailsForSourceOneLake[WarehouseId],
                    detailsForSourceOneLake[WorkspaceId],
                    apiUrl)
                else 
                    Action.DoNothing
        in
            [
                CopyActions = withActions[Actions],
                StateTableAction = storeDataInStateTable,
                ParquetMetadataActions = withParquetMetdataActions[ParquetMetadataActions],
                DeltaLogActions = withDeltaFixupActions[DeltaFixupActions],
                CreateDwTableAction = createDWTableAction,
                DropTableFromDWAction = dropTableFromDWAction
            ],

    UpdateDeltaLogWithFileReference = (deltaTable, parquetContent) =>
        let
            parquetTable = Parquet.Document(parquetContent, [TypeMapping = "Sql"]),
            modifiedMeta = KeepDeltaFile(parquetTable)
        in
            Diagnostics.Trace(
                TraceLevel.Information,
                [Name = "UpdateDeltaLogWithFileReference", Data = []],
                Action.Sequence({
                    TableAction.InsertRows(deltaTable, modifiedMeta),
                    Action.DoNothing
                })),
    
    KeepDeltaFile = (table) =>
        let
            rowType = Type.RecordFields(Type.TableRow(Value.Type(table))),
            withTags = List.Transform(
                Record.ToList(rowType),
                (t) => [Type = t[Type] meta [Delta.UseFileReference = true], Optional = false]),
            newType = type table Type.ForRecord(Record.FromList(withTags, Record.FieldNames(rowType)), false)
        in
            Value.ReplaceType(table, newType),

    ConvertDFSToBlobUrl = (url) => Text.Replace(url, ".dfs.", ".blob."),

    ParquetMetadataActions = (parquetFile, sourceSchema as list) =>
        let
            length = List.Count(sourceSchema),
            schema = Parquet.Metadata(parquetFile)[Schema],
            listWithActualSchemaColumns = List.Generate(
                () => [i = 0],
                each [i] < length,
                each [i = [i] + 1],
                each Record.FromList(
                    { sourceSchema{[i]} },
                    { schema[Name]{[i] + 1} }
                )
            ),
            combined = Record.Combine(listWithActualSchemaColumns)
        in
            Diagnostics.Trace(
                TraceLevel.Information,
                [Name = "UpdateParquetMetadata", Data = []],
                Action.Sequence({
                    TableAction.UpdateRows(
                        schema,
                        {
                            {"Name", each Record.FieldOrDefault(combined, [Name], [Name])}
                        }),
                    Action.DoNothing})),

    TryCopyActionsInParallel = (listOfActions as list, operationName as text, maxConcurrency  as number) =>
        InstrumentActions(
            ListAction.ParallelExecute(listOfActions, maxConcurrency),
            operationName),

    InstrumentActions = (actions, operationName as text) =>
        let
            startTime = DateTime.LocalNow(),
            listOfActions = if (actions is list) then actions else {actions},
            result = Action.Sequence({
                () => Diagnostics.Trace(
                    TraceLevel.Information,
                    [
                        Name = "InstrumentActions/Start",
                        Data = [ OperationName = operationName ]
                    ],
                    Action.Return(startTime)),
                (r) => Action.Sequence(listOfActions & {Action.Return(r)}),
                (r) => Diagnostics.Trace(
                    TraceLevel.Information,
                    [
                        Name = "InstrumentActions/Duration",
                        Data = [
                            OperationName = Utils[NonPii](operationName),
                            ActionDuration = Utils[NonPii](Utils[Value.ToText](Duration.TotalSeconds(DateTime.LocalNow() - r)))
                        ]
                    ],
                    Action.Return(true))
            })
        in
            result,

    // If we are unable to execute the fast copy actions for any reason, 
    // we should fallback to the default flow of deleting/creating the table.
    ExecuteFastCopyActionsOrDefault = (markerFileActions, deltaFastCopyActions as record, defaultActions, maxConcurrency) =>
        let
            actions = Action.Sequence({
                () => markerFileActions,
                () => Diagnostics.Trace(
                    TraceLevel.Information,
                    [Name = "DeltaTableFastCopyInsertTableToDwAction", Data = []],
                    InstrumentActions(deltaFastCopyActions[CreateDwTableAction], "InsertTableToStagingDW")),
                () => Diagnostics.Trace(
                    TraceLevel.Information,
                    [Name = "DeltaTableFastCopyCopyActions", Data = []],
                    TryCopyActionsInParallel(deltaFastCopyActions[CopyActions], "CopyDWParquetFiles", maxConcurrency)),
                () => Diagnostics.Trace(
                    TraceLevel.Information,
                    [Name = "DeltaTableFastCopyStateTableAction", Data = []],
                    deltaFastCopyActions[StateTableAction]),
                () => Diagnostics.Trace(
                    TraceLevel.Information,
                    [Name = "DeltaTableFastCopyPQMetadataActions", Data = []],
                    InstrumentActions(deltaFastCopyActions[ParquetMetadataActions], "DeltaTableFastCopyPQMetadataActions")),
                () => Diagnostics.Trace(
                    TraceLevel.Information,
                    [Name = "DeltaTableFastCopyDeltaLogActions", Data = []],
                    InstrumentActions(deltaFastCopyActions[DeltaLogActions], "DeltaTableFastCopyDeltaLogActions")),
                () => Diagnostics.Trace(
                    TraceLevel.Information,
                    [Name = "DeltaTableFastCopyDropDWTableAction", Data = []],
                    InstrumentActions(deltaFastCopyActions[DropTableFromDWAction], "DropTableFromDWAction")),
                () => Action.DoNothing
            })
        in
            Action.Sequence
            ({
                () => Action.Try(actions),
                (r) => if (r[HasError]) then
                    Diagnostics.Trace(TraceLevel.Warning, [Name = "DeltaTableFastCopyError",
                            Data = [Exception = Utils[Value.ToText](r[Error])]], defaultActions)
                else 
                    Action.Return(r[Value])
            }),


    State.DeltaTableFastCopyTable = (Id) as nullable table =>
        Extension.State(){[Name = Id]}?[Value]?,

    // Store Information about the FileNames which have been copied over.
    State.DeltaTableFastCopyTableStoreActions = (versionKey, tableKey, dataToStore) =>
        let
            stateTableKey = versionKey & "_" & tableKey,
            tableActionsValue = State.DeltaTableFastCopyTable(stateTableKey),
            finalResultToStore = Diagnostics.Trace(
                TraceLevel.Information,
                [Name = "UpdatedDeltaTableFastCopyVersionTable", Data = []],
                dataToStore),
            generateTableToStore = #table({"DeltaTableFastCopyDetails"}, {{dataToStore}}),
            updateOrInsertAction =
                if Extension.State()[Name]? = null or Extension.State(){[Name = stateTableKey]}? = null then
                    TableAction.InsertRows(
                        Extension.State(),
                        #table({"Name", "Value"}, {{stateTableKey, generateTableToStore}}))
                else
                    Action.Sequence({
                        TableAction.DeleteRows(Table.SelectRows(Extension.State(), each [Name] = stateTableKey)),
                        TableAction.InsertRows(
                            Extension.State(),
                            #table({"Name", "Value"}, {{stateTableKey, generateTableToStore}}))
                    }),
            insertActions = Diagnostics.Trace(
                TraceLevel.Information,
                [Name = "DeltaTableFastCopyStateTableAction", Data = []],
                Action.Sequence(
                    {
                        () => updateOrInsertAction,
                        () => Action.Return(dataToStore)
                    }))
        in
            try insertActions 
            catch(e) => error Diagnostics.Trace(
                TraceLevel.Error,
                [Name = "DeltaTableFastCopyStateTableError", Data = [Error = Utils[Value.ToText](e)]],
                Table.ViewError(e))

in
[
    TryCopyActionsInParallel = TryCopyActionsInParallel,
    GenerateDeltaTableFastCopyActions = GenerateDeltaTableFastCopyActions,
    UpdateDeltaLogWithFileReference = UpdateDeltaLogWithFileReference,
    InstrumentActions = InstrumentActions,
    ShouldUseDeltaTableFastCopy = ShouldUseDeltaTableFastCopy,
    DeltaTableFastCopyDetails = DeltaTableFastCopyDetails,
    ExecuteFastCopyActionsOrDefault = ExecuteFastCopyActionsOrDefault,
    CheckIfDeltaLogPublishingIsEnabled = CheckIfDeltaLogPublishingIsEnabled,
    GetDWDetailsForCleanUp = GetDWDetailsForCleanUp,
    DropTableFromDWActions = DropTableFromDWActions,
    BuildStagingDWTableName = BuildStagingDWTableName
]
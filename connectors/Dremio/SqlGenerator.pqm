// This module creates SqlGenerator for Dremio connector. It has three different parts :
// 1) Template that each developer should follow (mandatory connector specific overrides like sqlgettypeinfo, defaulttypes etc).
// 2) SqlGenerator template that will be shared with developer.
// 3) Function overrides and helpers that can be used. This is not mandatory but will be a big section so have been kept separately.
 let
 // This is first part of SqlGenerator and accomplishes :\
 //  1) Create connector specifi configurations SqlGetTypeInfo, SupportedConversions, SqlTypeCategories
 //     DefaultType
 //  2) Merge all the overrides to base SqlGenerator configuration using helper MergeOverrides
 //  3) Add additional folding capabilities to AstVisitor. These are to fold LimitClause and Cast operation.
 //     Both of these have been brought as it is from ODBC.
    GetNumberLiteral = (value as number) => Number.ToText(value),
    GetTimeLiteral = (value as time) => Time.ToText(value,[Format="HH:mm:ss.FFFFFFF"]),
    GetDateLiteral = (value as date) => Date.ToText(value,[Format="yyyy-MM-dd"]),
    GetDateTimeLiteral = (value as datetime) as text => DateTime.ToText(value,[Format="yyyy-MM-dd HH:mm:ss.FFFFFFF"]),
    GetStringLiteral = (value as text) as text => "'" & Text.Replace(value, "'", "\'") & "'",
    GetUuidLiteral = (value) as text => "'" & Text.Replace(value, "'", "\'") & "'",
    
    // Dremio Type Names
    DT_ARRAY = "ARRAY",
    DT_BIGINT = "BIGINT",
    DT_BINARY = "BINARY",
    DT_BINARY_VARYING = "BINARY VARYING",
    DT_BOOLEAN = "BOOLEAN",
    DT_CHARACTER = "CHARACTER",
    DT_CHARACTER_VARYING = "CHARACTER VARYING",
    DT_DATE = "DATE",
    DT_DECIMAL = "DECIMAL",
    DT_DECIMAL_CAST = "DECIMAL(38, 9)",
    DT_DOUBLE = "DOUBLE",
    DT_FLOAT = "FLOAT",
    DT_INTEGER = "INTEGER",
    DT_INTERVAL_DAY_TO_SECOND = "INTERVAL DAY TO SECOND",
    DT_INTERVAL_YEAR_TO_MONTH = "INTERVAL YEAR TO MONTH",
    DT_MAP = "MAP",
    DT_NATIONAL_CHARACTER = "NATIONAL CHARACTER",
    DT_NATIONAL_CHARACTER_VARYING = "NATIONAL CHARACTER VARYING",
    DT_ROW = "ROW",
    DT_SMALLINT = "SMALLINT",
    DT_TIME = "TIME",
    DT_TIMESTAMP = "TIMESTAMP",
    DT_TINYINT = "TINYINT",
    DT_UUID = "UUID",

// SqlGetTypeInfo provides information about native types supported by datasource.
//   Table Columns :
//   SqlTypeName :    TextValue (not null)   Native data-type name; for example, "CHAR()", "VARCHAR()", "MONEY", "LONG VARBINARY", or "CHAR ( ) FOR BIT DATA"
//   Type :           Type (not null)        Equivalent M Type
//   ColumnSize:      Number                 The maximum column size that the server supports for this data type. For numeric data, this is the maximum precision. For string data, this is the
//                                           length in characters. For datetime data types, this is the length in characters of the string representation (assuming the maximum allowed precision of the fractional
//                                           seconds component). NULL is returned for data types where column size is not applicable. For interval data types, this is the number of characters in the character
//                                           representation of the interval literal
//   GetLiteral:      FunctionValue          This function returns the literal representation of a value for a given type according to this data source
//   SEARCHABLE:      Number                 How the data type is used in a WHERE clause:
//                                            0 --->  if the column cannot be used in a WHERE clause.
//                                            1 --->  if the column can be used in a WHERE clause, but only with the LIKE predicate.
//                                            2 --->  if the column can be used in a WHERE clause with all the comparison operators except LIKE (comparison, quantified comparison, BETWEEN, DISTINCT, IN, MATCH, and UNIQUE).
//                                            3 --->  if the column can be used in a WHERE clause with any comparison operator.
//   UnsignedAttribute Number                Whether the data type is unsigned:
//                                            0 --->  if the data type is signed.
//                                            1 --->  if the data type is unsigned.
//                                            null ---> if the attribute is not applicable to the data type or the data type is not numeric.
//   NumericPrecisionRadix Number            If the data type is an approximate numeric type, this column contains the value 2, indicating that COLUMN_SIZE specifies a number of bits.
//                                           For exact numeric types, this column contains the value 10, indicating that COLUMN_SIZE specifies a number of decimal digits. Otherwise, this column is NULL.
    SqlGetTypeInfo = #table( { "SqlTypeName","Type", "ColumnSize", "GetLiteral", "Searchable", "UnsignedAttribute", "NumericPrecisionRadix" }, {
        {DT_ARRAY, Text.Type,  2147483647, null, 3, null, null},
        {DT_BIGINT, Int64.Type, 19, GetNumberLiteral, 2, 0, 2},
        {DT_BINARY, Binary.Type, 2147483647, null, 3, null, null},
        {DT_BINARY_VARYING, Binary.Type, 2147483647, null, 3, null, null},
        {DT_BOOLEAN, Logical.Type, 1, null, 2, null, null},
        {DT_CHARACTER, Text.Type, 2147483647, GetStringLiteral, 3, null, null},
        {DT_CHARACTER_VARYING, Text.Type, 2147483647, GetStringLiteral, 3, null, null},
        {DT_DATE, Date.Type, 10, GetDateLiteral, 3, null, null},
        {DT_DECIMAL, Decimal.Type, 38, GetNumberLiteral, 2, 0, 10},
        {DT_DECIMAL_CAST, Decimal.Type, 38, GetNumberLiteral, 2, 0, 10},
        {DT_DOUBLE, Double.Type, 53, GetNumberLiteral, 2, 0, 2},
        {DT_FLOAT, Single.Type, 24, GetNumberLiteral, 2, 0, 2},
        {DT_INTEGER, Int32.Type, 10, GetNumberLiteral, 2, 0, 2},
        //{DT_INTERVAL_DAY_TO_SECOND, .Type, 18, GetLiteral, 2, null, null},
        //{DT_INTERVAL_YEAR_TO_MONTH, .Type, 5, GetLiteral, 2, null, null},
        //{DT_MAP, .Type, 2147483647, GetLiteral, 2, null, null},
        {DT_NATIONAL_CHARACTER, Text.Type, 2147483647, GetStringLiteral, 3, null, null},
        {DT_NATIONAL_CHARACTER_VARYING, Text.Type, 2147483647, GetStringLiteral, 3, null, null},
        {DT_ROW, Text.Type, 2147483647, null, 3, null, null},
        {DT_SMALLINT, Int16.Type, 5, GetNumberLiteral, 2, 0, 2},
        {DT_TIME, Time.Type, 12, GetTimeLiteral, 3, null, null},
        {DT_TIMESTAMP, DateTime.Type, 23, GetDateTimeLiteral, 3, null, null},
        {DT_TINYINT, Int16.Type, 3, GetNumberLiteral, 2, 0, 2},
        {DT_UUID, Guid.Type, 36, null, 3, null, null}
    }),

// SupportedConversions provides information about supported data type conversions.
//   Table Columns :
//   FromSqlTypeName :    TextValue (not null)   SqlTypeName that needs to be converted
//   ToSqlTypeNames :     List Value             List of SqlTypeNames to which FromSqlTypeName cane be converted

//TODO NATIONCAL_CHARACTER, NATIONAL_CHARACTER_VARYING, INTERVAL_DAY_TO_SECOND, INTERVAL_YEAR_TO_MONTH, MAP, ROW
    SupportedConversions = #table({"FromSqlTypeName","ToSqlTypeNames"}, {
        {DT_BIGINT,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE}},
        {DT_INTEGER,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE}},
        {DT_SMALLINT,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE}},
        {DT_TINYINT,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE}},
        {DT_BINARY,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_BINARY,DT_BINARY_VARYING}},
        {DT_BOOLEAN,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE}},
        {DT_CHARACTER,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE,DT_BINARY,DT_BINARY_VARYING,DT_DATE,DT_TIME,DT_TIMESTAMP}},
        {DT_DECIMAL,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE}},
        {DT_DOUBLE,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE}},
        {DT_FLOAT,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE}},
        {DT_TIMESTAMP,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DATE,DT_TIME,DT_TIMESTAMP}},
        {DT_DATE,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_DATE,DT_TIME,DT_TIMESTAMP}},
        {DT_TIME,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_TIME}},
        {DT_BINARY_VARYING,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_BINARY,DT_BINARY_VARYING}},
        {DT_UUID,{DT_CHARACTER,DT_CHARACTER_VARYING,DT_BINARY,DT_BINARY_VARYING}},
        {DT_CHARACTER_VARYING,{DT_UUID,DT_CHARACTER,DT_CHARACTER_VARYING,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT,DT_FLOAT,DT_DOUBLE,DT_BINARY,DT_BINARY_VARYING,DT_DATE,DT_TIME,DT_TIMESTAMP}}}
    ),

   SqlTypesCategories = [
// These are used internally by MashupEngine when useSoftNumbers is true. It is a list of SqlTtypeNames which follow a certain order based on
// Odbc Sql Type Code
// For SoftBase2Types it is {DOUBLE,FLOAT,REAL,DECIMAL,NUMERIC,BIGINT,INTEGER}
// For SoftBase10Types it is {DECIMAL,NUMERIC,DOUBLE,FLOAT,REAL,DECIMAL,BIGINT,INTEGER}
        SoftBase2Types = {DT_DOUBLE,DT_FLOAT,DT_DECIMAL,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT},
        SoftBase10Types = {DT_DECIMAL,DT_DOUBLE,DT_FLOAT,DT_BIGINT,DT_INTEGER,DT_SMALLINT,DT_TINYINT},
//This is a list of different types of SQL type categories, arranged in ascending order of size.
// When the TolerateConcatOverflow SQL capability is set to true, it uses the following lists (based on SqlTypeName) to fit the result of operations into
// the largest compatible type in the event of overflow scenarios caused by various operations on SQL types.
        VarBinaryTypes = {DT_UUID,DT_BINARY_VARYING},
        WideCharTypes = {DT_NATIONAL_CHARACTER, DT_NATIONAL_CHARACTER_VARYING},
        VarCharTypes = {DT_UUID,DT_CHARACTER_VARYING},
        WideVarCharTypes = {DT_NATIONAL_CHARACTER_VARYING}
    ],

// Default SqlTypes for M Types
//   Table Columns :
//   Type :          TypeValue   M Type
//   SqlTypeName :   TextValue   Default SqlType Name for M Type
    DefaultTypes = #table({"Type","SqlTypeName"},
        {{Double.Type, DT_DOUBLE},
        {Date.Type, DT_DATE},
        {DateTime.Type, DT_TIMESTAMP},
        {Time.Type,DT_TIME},
        {Text.Type,DT_CHARACTER_VARYING},
        {Int32.Type,DT_INTEGER},
        {Int64.Type,DT_BIGINT},
        {Decimal.Type,DT_DECIMAL},
        {Single.Type,DT_FLOAT},
        {Logical.Type,DT_BOOLEAN},
        {Binary.Type,DT_BINARY}}
    ),

    TypeFacets = [
        #"CHARACTER VARYING" = Type.ReplaceFacets(Text.Type,[NativeTypeName = DT_CHARACTER_VARYING]),
        #"DOUBLE" = Type.ReplaceFacets(Double.Type,[NativeTypeName = DT_DOUBLE,NumericPrecisionBase = 2,NumericPrecision = 53]),
        #"INTEGER" = Type.ReplaceFacets(Number.Type, [NativeTypeName = DT_INTEGER]),
        #"BIGINT" = Type.ReplaceFacets(Number.Type,[NativeTypeName = DT_BIGINT]),
        #"DATE" = Type.ReplaceFacets(Date.Type,[NativeTypeName = DT_DATE]),
        #"TIMESTAMP" = Type.ReplaceFacets(DateTime.Type,[NativeTypeName = DT_TIMESTAMP]),
        #"TIME" = Type.ReplaceFacets(Time.Type,[NativeTypeName = DT_TIME]),
        #"ARRAY" =  Type.ReplaceFacets(Text.Type,[NativeTypeName = DT_ARRAY]),
        #"BOOLEAN" = Type.ReplaceFacets(Logical.Type,[NativeTypeName = DT_BOOLEAN]),
        #"DECIMAL" = Type.ReplaceFacets(Decimal.Type, [NativeTypeName = DT_DECIMAL]),
        #"FLOAT" = Type.ReplaceFacets(Single.Type,[NativeTypeName = DT_FLOAT]),
        #"BINARY VARYING" = Type.ReplaceFacets(Binary.Type,[NativeTypeName = DT_BINARY_VARYING]),
        #"UUID" = Type.ReplaceFacets(Guid.Type,[NativeTypeName = DT_UUID])
    ],
    TimestampFunctionOverrides = [],
    // Duration decomposition needs truncation toward zero so negative durations keep the
    // same whole-part/fractional-part split that Power Query uses.
    RoundTowardZero = (value) => if value < 0 then Number.RoundUp(value) else Number.RoundDown(value),
    // Dremio rejects sub-second TIMESTAMPADD parts, but it does accept DAY TO SECOND
    // interval literals with millisecond precision. Format just the fractional remainder here.
    FormatFractionalMillisecondIntervalLiteral = (milliseconds as number) as text =>
        let
            millisecondText = Number.ToText(Number.Round(Number.Abs(milliseconds), 0), "F0", "en-US"),
            fractionalText = Text.PadStart(millisecondText, 3, "0")
        in
            Text.Format("INTERVAL '0 00:00:00.#{0}' DAY TO SECOND", { fractionalText }),
    // Only constant durations with a fractional-second component need the special Dremio path.
    // Whole-second values can continue to use the base implementation.
    HasSubsecondDuration = (durationValue) =>
        let
            zeroDuration = #duration(0,0,0,0),
            normalizedDuration = if durationValue < zeroDuration then -durationValue else durationValue,
            seconds = Duration.Seconds(normalizedDuration)
        in
            seconds <> RoundTowardZero(seconds),
    // Break a constant duration into whole DAY/HOUR/MINUTE/SECOND TIMESTAMPADD calls plus a
    // millisecond INTERVAL remainder so Dremio never sees an unsupported sub-second part.
    ApplyConstantDurationToDatetime = (datetimeExpr, durationValue, sign) =>
        let
            zeroDuration = #duration(0,0,0,0),
            durationSign = if durationValue < zeroDuration then -1 else 1,
            normalizedDuration = if durationSign = -1 then -durationValue else durationValue,
            effectiveSign = durationSign * sign,
            wholeSeconds = RoundTowardZero(Duration.Seconds(normalizedDuration)),
            // Power Query durations are stored in 100ns ticks, but Dremio timestamps only preserve
            // milliseconds, so truncate the fractional remainder at the millisecond boundary.
            fractionalSecondTicks = RoundTowardZero((Duration.Seconds(normalizedDuration) - wholeSeconds) * 10000000),
            fractionalMilliseconds = RoundTowardZero(fractionalSecondTicks / 10000),
            durationParts = {
                [Part = "DAY", Amount = Duration.Days(normalizedDuration) * effectiveSign],
                [Part = "HOUR", Amount = Duration.Hours(normalizedDuration) * effectiveSign],
                [Part = "MINUTE", Amount = Duration.Minutes(normalizedDuration) * effectiveSign],
                [Part = "SECOND", Amount = wholeSeconds * effectiveSign]
            },
            nonZeroDurationParts = List.Select(durationParts, each _[Amount] <> 0),
            withWholeParts = List.Accumulate(
                nonZeroDurationParts,
                datetimeExpr,
                (state, current) =>
                    InvocationWithType(
                        CreateArguments({LiteralText(current[Part]), LiteralWithType(Text.From(current[Amount]), integerTypeWithFacets), state}),
                        "TIMESTAMPADD",
                        datetimeExpr[Type])),
            fractionalInterval = LiteralWithType(FormatFractionalMillisecondIntervalLiteral(fractionalMilliseconds), durationTypeWithFacets),
            fractionalOperator = if effectiveSign < 0 then "Subtract" else "Add"
        in
            if fractionalMilliseconds = 0 then
                withWholeParts
            else
                BinaryOperationWithType(withWholeParts, fractionalOperator, fractionalInterval, datetimeExpr[Type]),
    // BinaryOperatorOverrides allow selective overriding of binary operator combinations.
    // Return null for combinations that should use the base implementation.
    //
    // Duration in Power BI:
    //   - Power BI Duration is measured in "ticks" (1 tick = 100 nanoseconds)
    //   - ticksPerSecond = 10,000,000 (10^7)
    //   - ticksPerDay = 864,000,000,000 (24 * 60 * 60 * 10^7)
    //
    // Dremio Limitation:
    //   - TIMESTAMPADD/TIMESTAMPDIFF cannot apply sub-second datetime parts directly
    //   - Dremio TIMESTAMP precision is milliseconds, so preserve sub-second constant durations
    //     by applying the fractional millisecond remainder as an INTERVAL DAY TO SECOND literal
    BinaryOperatorOverrides = [
        // Intercept constant datetime +/- duration cases only when they contain a fractional second.
        // This preserves the default generator behavior for all other add scenarios.
        Add = (visitor, rowType, groupKeys, ast) =>
            let
                left = visitor(ast[Left]),
                right = visitor(ast[Right]),
                isDatetime = (expr) => Type.Is(expr[Type], type nullable datetime),
                isDurationConstantAst = (exprAst) =>
                    exprAst[Kind]? = "Constant" and Value.Is(exprAst[Value]?, type duration),
                result =
                    if isDatetime(left) and isDurationConstantAst(ast[Right]) and HasSubsecondDuration(ast[Right][Value]) then
                        ApplyConstantDurationToDatetime(left, ast[Right][Value], 1)
                    else if isDurationConstantAst(ast[Left]) and isDatetime(right) and HasSubsecondDuration(ast[Left][Value]) then
                        ApplyConstantDurationToDatetime(right, ast[Left][Value], 1)
                    else
                        null
            in
                result,
        // Subtract operator override for temporal types
        Subtract = (visitor, rowType, groupKeys, ast) =>
            let
                left = visitor(ast[Left]),
                right = visitor(ast[Right]),

                // Type checking helpers
                isDate = (expr) => Type.Is(expr[Type], type nullable date),
                isDatetime = (expr) => Type.Is(expr[Type], type nullable datetime),
                isTime = (expr) => Type.Is(expr[Type], type nullable time),
                isDuration = (expr) => Type.Is(expr[Type], type nullable duration),
                isDurationConstantAst = (exprAst) =>
                    exprAst[Kind]? = "Constant" and Value.Is(exprAst[Value]?, type duration),
                isDurationAst = (exprAst, expr) =>
                    isDuration(expr) or
                    isDurationConstantAst(exprAst),
                ticksPerDay = LiteralWithType("864000000000", bigIntTypeWithFacets),

                // Cast date to timestamp for mixed-type operations
                toTimestamp = (expr) =>
                    if isDate(expr) then
                        CastSqlExpression(expr, datetimeTypeWithFacets)
                    else
                        expr,

                // Helper: Calculate datetime difference in ticks
                // Formula: (daysDiff * ticksPerDay) + (secondsDiff * ticksPerSecond)
                // Where ticksPerSecond = 10,000,000 and ticksPerDay = 864,000,000,000
                datetimeDiffTicks = (leftDt, rightDt) =>
                    let
                        // Get whole days difference
                        daysDiff = InvocationWithType(
                            CreateArguments({LiteralText("DAY"), rightDt, leftDt}),
                            "TIMESTAMPDIFF",
                            bigIntTypeWithFacets),
                        // Add days to right to get the same-day baseline for seconds calculation
                        rightPlusDays = InvocationWithType(
                            CreateArguments({LiteralText("DAY"), daysDiff, rightDt}),
                            "TIMESTAMPADD",
                            datetimeTypeWithFacets),
                        // Get remaining seconds difference
                        secondsDiff = InvocationWithType(
                            CreateArguments({LiteralText("SECOND"), rightPlusDays, leftDt}),
                            "TIMESTAMPDIFF",
                            bigIntTypeWithFacets),
                        // Convert to ticks: (daysDiff * 864000000000) + (secondsDiff * 10000000)
                        ticksPerSecond = LiteralWithType("10000000", bigIntTypeWithFacets),
                        daysInTicks = BinaryOperationWithType(
                            CastSqlExpression(daysDiff, bigIntTypeWithFacets),
                            "Multiply",
                            ticksPerDay,
                            bigIntTypeWithFacets),
                        secondsInTicks = BinaryOperationWithType(
                            CastSqlExpression(secondsDiff, bigIntTypeWithFacets),
                            "Multiply",
                            ticksPerSecond,
                            bigIntTypeWithFacets),
                        totalTicks = BinaryOperationWithType(daysInTicks, "Add", secondsInTicks, durationTypeWithFacets)
                    in
                        totalTicks,

                // Power Query ignores sub-day duration components when subtracting a duration from a date.
                wholeDaysFromDuration = (durationExpr) =>
                    let
                        durationAsDouble = CastSqlExpression(durationExpr, doubleTypeWithFacets),
                        ticksPerDayDouble = LiteralWithType("864000000000", doubleTypeWithFacets),
                        totalDays = BinaryOperationWithType(durationAsDouble, "Divide", ticksPerDayDouble, doubleTypeWithFacets),
                        flooredDays = InvocationWithType({ArgumentWithType(totalDays, doubleTypeWithFacets)}, "FLOOR", doubleTypeWithFacets),
                        ceiledDays = InvocationWithType({ArgumentWithType(totalDays, doubleTypeWithFacets)}, "CEIL", doubleTypeWithFacets),
                        negativeDays = WhenItem(
                            BinaryLogicalOperation("LessThan", totalDays, LiteralWithType("0", doubleTypeWithFacets)),
                            ceiledDays,
                            doubleTypeWithFacets),
                        truncatedDays = CaseFunction({negativeDays}, flooredDays, null, doubleTypeWithFacets)
                    in
                        CastSqlExpression(truncatedDays, bigIntTypeWithFacets),

                result =
                    // DATE - DATE: Return number of days as integer
                    if isDate(left) and isDate(right) then
                        InvocationWithType(
                            CreateArguments({LiteralText("DAY"), right, left}),
                            "TIMESTAMPDIFF",
                            bigIntTypeWithFacets)

                    // DATETIME - DATETIME: Return duration in ticks
                    else if isDatetime(left) and isDatetime(right) then
                        datetimeDiffTicks(left, right)

                    // DATETIME - DATE: Cast date to timestamp, return duration in ticks
                    else if isDatetime(left) and isDate(right) then
                        datetimeDiffTicks(left, toTimestamp(right))

                    // DATE - DATETIME: Cast date to timestamp, return duration in ticks
                    else if isDate(left) and isDatetime(right) then
                        datetimeDiffTicks(toTimestamp(left), right)

                    // DATETIME - DURATION constant: reuse the same decomposition helper, but flip the
                    // overall sign so the fractional millisecond remainder is subtracted instead of added.
                    else if isDatetime(left) and isDurationConstantAst(ast[Right]) and HasSubsecondDuration(ast[Right][Value]) then
                        ApplyConstantDurationToDatetime(left, ast[Right][Value], -1)

                    // DATE - DURATION: subtract whole days only and preserve DATE result
                    else if isDate(left) and isDurationAst(ast[Right], right) then
                        let
                            wholeDays = wholeDaysFromDuration(right),
                            negativeWholeDays = BinaryOperationWithType(
                                CastSqlExpression(minusone, bigIntTypeWithFacets),
                                "Multiply",
                                wholeDays,
                                bigIntTypeWithFacets)
                        in
                            InvocationWithType(
                                CreateArguments({LiteralText("DAY"), negativeWholeDays, left}),
                                "TIMESTAMPADD",
                                datetypewithFacets)

                    // TIME - TIME: Return duration in ticks (seconds * ticksPerSecond)
                    // Dremio doesn't support TIMESTAMPDIFF on TIME directly, so cast to TIMESTAMP first
                    else if isTime(left) and isTime(right) then
                        let
                            // Cast TIME to TIMESTAMP (Dremio uses 1970-01-01 as base date)
                            leftAsTimestamp = CastSqlExpression(left, datetimeTypeWithFacets),
                            rightAsTimestamp = CastSqlExpression(right, datetimeTypeWithFacets),
                            secondsDiff = InvocationWithType(
                                CreateArguments({LiteralText("SECOND"), rightAsTimestamp, leftAsTimestamp}),
                                "TIMESTAMPDIFF",
                                bigIntTypeWithFacets),
                            ticksPerSecond = LiteralWithType("10000000", bigIntTypeWithFacets)
                        in
                            // Cast secondsDiff to BIGINT to avoid integer overflow
                            BinaryOperationWithType(
                                CastSqlExpression(secondsDiff, bigIntTypeWithFacets),
                                "Multiply",
                                ticksPerSecond,
                                durationTypeWithFacets)

                    // All other cases: fall back to base implementation
                    else null
            in
                result,
        Equals = (visitor, rowType, groupKeys, ast) =>
            HandleCustomTypeComparison("Equals", visitor, ast),
        LessThan = (visitor, rowType, groupKeys, ast) =>
            HandleCustomTypeComparison("LessThan", visitor, ast),
        GreaterThan = (visitor, rowType, groupKeys, ast) =>
            HandleCustomTypeComparison("GreaterThan", visitor, ast),
        NotEquals = (visitor, rowType, groupKeys, ast) =>
            HandleCustomTypeComparison("NotEqualTo", visitor, ast),
        GreaterThanOrEquals = (visitor, rowType, groupKeys, ast) =>
            HandleCustomTypeComparison("GreaterThanOrEqual", visitor, ast),
        LessThanOrEquals = (visitor, rowType, groupKeys, ast) =>
            HandleCustomTypeComparison("LessThanOrEqual", visitor, ast)
    ],
// Create Override Record and use Merge Overrides to merge it
    Override = [
         SqlGetTypeInfo = SqlGetTypeInfo,
         SqlCapabilities = [],
         FunctionOverrides = DremioSimpleFunctionOverrides & AdbcFunctionOverrides,
         TimestampFunctionOverrides = TimestampFunctionOverrides,
         BinaryOperatorOverrides = BinaryOperatorOverrides,
         UnaryOperatorOverrides = [],
         DefaultTypes = DefaultTypes,
         SupportedConversions = SupportedConversions,
         SqlTypesCategories = SqlTypesCategories
     ],

    SqlGenerator = SqlGeneratorCommon[MergeOverrides]("Sql92",Override,false),
    currentAstVisitorRecord = SqlGenerator[AstVisitor],

//This is common logic for both Adbc and Odbc, it adds two AST visitors, one for Limit Clause and other for casting constants
    addToAstVisitor =
      [
        AstVisitor = currentAstVisitorRecord &
         [
           LimitClause = (skip, take) =>
             if skip = 0 and take = null then
               error "NoopSkipTakeError"
             else
               let
                 limitPart = if take <> null then Text.Format("LIMIT #{0}", { take }) else "",
                 offsetPart = if skip <> null then Text.Format("OFFSET #{0}", { skip }) else "",
                 delimiter = if limitPart <> "" and offsetPart <> "" then " " else ""
                in
                 [
                   Text = limitPart & delimiter & offsetPart,
                   Location = "AfterQuerySpecification"
                 ],
           Constant =
              let
                 Quote = each Text.Format("'#{0}'", { _ }),
                 Cast = (value, typeName) => [
                        Text = Text.Format("CAST(#{0} as #{1})", { value, typeName }, "") ],
                 Function = (functionname, p1, p2) => [
                        Text = Text.Format("#{0}(#{1},#{2})", { functionname, p1, p2 })],
                 DateFormatted = (value) => [
                        Text = Text.Format("{d '#{0}'}", { Date.ToText(value, "yyyy-MM-dd") })],
                 TimestampFormatted = (value) => [
                         Text = Text.Format("{ts '#{0}'}", { DateTime.ToText(value, "yyyy-MM-dd HH:mm:ss.fffffff") }) ],
                 TimeFormatted = (value) => [
                        Text = Text.Format("{t '#{0}'}", { Time.ToText(value, "HH:mm:ss.fffffff") })],
                 Visitor = [
                  // This is to work around parameters being converted to VARCHAR
                  // and to work around driver crash when using TYPE_TIME parameters.
                  BOOLEAN = each [Text = Text.From(_) ],
                  DECIMAL = each Cast(_, DT_DECIMAL_CAST),
                  INTEGER = each Cast(_, DT_INTEGER),
                  BIGINT = each Cast(_, DT_BIGINT),
                  SMALLINT = each Cast(_, DT_SMALLINT),
                  TINYINT = each Cast(_, DT_TINYINT),
                  FLOAT = each Cast(_, DT_FLOAT),
                  DOUBLE = each Cast(_, DT_DOUBLE),
                  UUID = each Cast(_, DT_UUID),
                  DATE = each DateFormatted(_),
                  TIMESTAMP = each TimestampFormatted(_),
                  TIME = each TimeFormatted(_)
                  ]
               in
                (typeInfo, ast) => Record.FieldOrDefault(Visitor, typeInfo[TYPE_NAME], each null)(ast[Value])
          ]
        ],

//  This is SqlGenerator template that will be shared with connector developers. Connector developers will be able to
//  use different base configurations, currently only Generators.Sql92.ID configuration is available.
//     1) It has couple of configurations (have details in comments below) which can be overridden
//     2) Helpers to create Sql Ast
//     3) Some Assert functions to validate overrides
//     4) Merge Override function to merge user overrides with SqlGenerator override.
    SqlGeneratorCommon = Extension.LoadExpression("SqlGeneratorCommon.pqm"),
    DremioSimpleFunctionOverrides = [
        Text.StartsWith = [Name = "STARTS_WITH",Type = Logical.Type],
        Text.EndsWith = [Name = "ENDS_WITH",Type = Logical.Type],
        Text.Repeat = "REPEATSTR",
        Character.FromNumber = "CHR",
        Time.Second = "second"
    ],
    // This is third part of SqlGenerator and has all the function overrides along with helpers.
    AdbcHelpers = SqlGeneratorCommon[Helpers],
    AdbcConstants =  SqlGeneratorCommon[Constants],
    funcName = SqlGeneratorCommon[FunctionNames],
//  Adbc Helpers to create basic Sql Ast
    SingleListElement = AdbcHelpers[SingleListElement],
    InExpression = AdbcHelpers[InExpression],
    GetInvocation = AdbcHelpers[GetInvocation],
    ApproxDistinctCount = AdbcHelpers[ApproxDistinctCount],
    WhenItem = AdbcHelpers[WhenItem],
    CaseFunction = AdbcHelpers[CaseFunction],
    ConditionOperation = AdbcHelpers[ConditionOperation],
    UnaryLogicalOperation = AdbcHelpers[UnaryLogicalOperation],
    BinaryLogicalOperation = AdbcHelpers[BinaryLogicalOperation],
    ArgumentWithType = AdbcHelpers[Argument],
    ArgumentAuto = (expr) => ArgumentWithType(expr, expr[Type]),
    Function = AdbcHelpers[Function],
    LiteralWithType = (literal, Type) => AdbcHelpers[Literal](literal) & [Type = Type],
    LiteralText = (literal) => LiteralWithType(literal, textTypeWithFacets),
    BinaryOperationWithType = (left, operator, right, Type) => AdbcHelpers[BinaryOperation](left, operator, right) & [Type = Type],
    InvocationWithType = AdbcHelpers[InvocationWithType],
    InvocationWithFirstType = (args, name) => // TODO InvocationWithType(args, name, args{0}[Type]),
        // We need to provide some specific subtype to mitigate the mashup engine bug of binary operator (i.e +/-) for Number.Type producing null
        InvocationWithType(args, name, if args{0}[Type] = Number.Type then decimalTypeWithFacets else args{0}[Type]),
    InvocationWithInt64 = (args, name) => InvocationWithType(args, name, bigIntTypeWithFacets),
    InArrayExpression = AdbcHelpers[InArrayExpression],
    SqlConstant = AdbcHelpers[SqlConstant],
    CastSqlExpression = AdbcHelpers[CastSqlExpression],
//  Sql Ast Constants
    minusone = LiteralWithType("-1", integerTypeWithFacets),
    one = LiteralWithType("1", integerTypeWithFacets),
    zero = LiteralWithType("0", integerTypeWithFacets),

//AdbcHelpers using NativeTypes
    CreateArguments = (args) => List.Transform(args, each ArgumentAuto(_)),

    OleAutomationDateSqlConst = SqlConstant("AnsiString", "1899-12-30", textTypeWithFacets),

    TryGetAstText = (ast as nullable record) as nullable text =>
        if ast = null then
            null
        else if Record.HasFields(ast, "MemberName") then
            Text.From(ast[MemberName])
        else if Record.HasFields(ast, "FieldName") then
            Text.From(ast[FieldName])
        else if Record.HasFields(ast, "Literal") then
            Text.From(ast[Literal])
        else if Record.HasFields(ast, "Name") then
            Text.From(ast[Name])
        else if Record.HasFields(ast, "Value") then
            try Text.From(ast[Value]) otherwise null
        else
            null,

    TryGetNativeTypeName = (t as nullable type) as nullable text =>
        let
            facets = if t = null then null else try Type.Facets(t) otherwise null,
            nativeTypeName = if facets = null then null else facets[NativeTypeName]?
        in
            if nativeTypeName = null then null else Text.From(nativeTypeName),

    IsDateLikeSqlType = (t as nullable type) as logical =>
        Type.Is(t, type nullable date) or TryGetNativeTypeName(t) = DT_DATE,

    IsDateTimeLikeSqlType = (t as nullable type) as logical =>
        Type.Is(t, type nullable datetime) or TryGetNativeTypeName(t) = DT_TIMESTAMP,

    IsTextLikeSqlType = (t as nullable type) as logical =>
        let
            nativeTypeName = TryGetNativeTypeName(t)
        in
            Type.Is(t, type nullable text) or List.Contains({DT_CHARACTER, DT_CHARACTER_VARYING, DT_NATIONAL_CHARACTER, DT_NATIONAL_CHARACTER_VARYING}, nativeTypeName),

    TextFromDateTimeEnUs = (sqlAstArg as record) as record =>
        let
            TextLiteral = (value as text) as record => SqlConstant("AnsiString", value, textTypeWithFacets),
            IntLiteral = (value as text) as record => LiteralWithType(value, integerTypeWithFacets),
            DatePart = (name as text) as record => InvocationWithType(CreateArguments({sqlAstArg}), name, integerTypeWithFacets),
            AsText = (expr as record) as record => CastSqlExpression(expr, textTypeWithFacets),
            Concat2 = (left as record, right as record) as record => InvocationWithType(CreateArguments({left, right}), "concat", textTypeWithFacets),
            ConcatMany = (values as list) as record =>
                List.Accumulate(List.Skip(values, 1), values{0}, (state as record, current as record) as record => Concat2(state, current)),
            Pad2 = (expr as record) as record =>
                CaseFunction(
                    {WhenItem(BinaryLogicalOperation("LessThan", expr, IntLiteral("10")), Concat2(TextLiteral("0"), AsText(expr)), textTypeWithFacets)},
                    AsText(expr),
                    null,
                    textTypeWithFacets),
            yearPart = DatePart("year"),
            monthPart = DatePart("month"),
            dayPart = DatePart("dayofmonth"),
            hourPart = DatePart("hour"),
            minutePart = DatePart("minute"),
            secondPart = DatePart("second"),
            hour12 = BinaryOperationWithType(
                InvocationWithType(
                    CreateArguments({
                        BinaryOperationWithType(hourPart, "Add", IntLiteral("11"), integerTypeWithFacets),
                        IntLiteral("12")
                    }),
                    "MOD",
                    integerTypeWithFacets),
                "Add",
                one,
                integerTypeWithFacets),
            amPm = CaseFunction(
                {WhenItem(BinaryLogicalOperation("LessThan", hourPart, IntLiteral("12")), TextLiteral("AM"), textTypeWithFacets)},
                TextLiteral("PM"),
                null,
                textTypeWithFacets)
        in
            ConcatMany({
                AsText(monthPart),
                TextLiteral("/"),
                AsText(dayPart),
                TextLiteral("/"),
                AsText(yearPart),
                TextLiteral(" "),
                AsText(hour12),
                TextLiteral(":"),
                Pad2(minutePart),
                TextLiteral(":"),
                Pad2(secondPart),
                TextLiteral(" "),
                amPm
            }),

    GetIntFromRoundingMode = (ast as nullable record) as nullable text =>
        let
            value = if ast = null then null else ast[Value]?,
            directMode =
                if value = RoundingMode.Down then
                    "down"
                else if value = RoundingMode.Up then
                    "up"
                else if value = RoundingMode.TowardZero then
                    "towardzero"
                else
                    null,
            textValue = Text.Lower(TryGetAstText(ast) ?? "")
        in
            if ast = null then
                null
            else if directMode <> null then
                directMode
            else if textValue = "down" or Text.Contains(textValue, "roundingmode.down") then
                "down"
            else if textValue = "up" or Text.Contains(textValue, "roundingmode.up") then
                "up"
            else if textValue = "towardzero" or textValue = "towardszero" or Text.Contains(textValue, "roundingmode.towardzero") or Text.Contains(textValue, "roundingmode.towardszero") then
                "towardzero"
            else
                null,

    GetIntFromRoundingModeFromArguments = (arguments as list) as nullable text =>
        let
            argCount = GetListCount(arguments),
            explicitMode = if argCount >= 3 then GetIntFromRoundingMode(arguments{2}) else null,
            lastArgMode = if argCount >= 2 then GetIntFromRoundingMode(List.Last(arguments)) else null
        in
            explicitMode ?? lastArgMode,

    IntFromHelper = (ast, visitor, facet) =>
        let
            sqlAstArg = visitor(ast[Arguments]{0}),
            roundingModeName = GetIntFromRoundingModeFromArguments(ast[Arguments]),
            oleAutomationDate0Date = CastSqlExpression(OleAutomationDateSqlConst, datetypewithFacets),
            oleAutomationDate0Timestamp = CastSqlExpression(OleAutomationDateSqlConst, datetimeTypeWithFacets),
            baseIntegerExpr =
                if IsDateLikeSqlType(sqlAstArg[Type]) then
                    InvocationWithType(CreateArguments({LiteralText("DAY"), oleAutomationDate0Date, sqlAstArg}), "TIMESTAMPDIFF", bigIntTypeWithFacets)
                else if IsDateTimeLikeSqlType(sqlAstArg[Type]) then
                    InvocationWithType(CreateArguments({LiteralText("DAY"), oleAutomationDate0Timestamp, sqlAstArg}), "TIMESTAMPDIFF", bigIntTypeWithFacets)
                else if IsTextLikeSqlType(sqlAstArg[Type]) then
                    CastSqlExpression(sqlAstArg, if roundingModeName = "down" then doubleTypeWithFacets else decimalTypeWithFacets)
                else
                    sqlAstArg,
            roundedExpr =
                if roundingModeName = "down" then
                    InvocationWithType({ArgumentWithType(CastSqlExpression(baseIntegerExpr, doubleTypeWithFacets), doubleTypeWithFacets)}, "FLOOR", doubleTypeWithFacets)
                else
                    baseIntegerExpr
        in
            CastSqlExpression(roundedExpr, facet),

    IntFromFactory = (func, integerTypeWithFacets) =>
        (visitor, rowType, groupKeys, ast) =>
            if ast[Kind] = "Invocation" and ast[Function][Kind] = "Constant" and ast[Function][Value] = func and GetListCount(ast[Arguments]) >= 1 and GetListCount(ast[Arguments]) <= 3 then
                IntFromHelper(ast, visitor, integerTypeWithFacets)
            else
                error "Invalid usage of IntFrom",

    NumberFromFactory = (func, numberTypeWithFacets) =>
        (visitor, rowType, groupKeys, ast) =>
            if ast[Kind] = "Invocation" and ast[Function][Kind] = "Constant" and ast[Function][Value] = func and GetListCount(ast[Arguments]) = 1 then
                CastSqlExpression(visitor(ast[Arguments]{0}), numberTypeWithFacets)
            else
                error "Invalid usage of NumberFrom",

    GetCountArgument = (ast as record, visitor as function, countNulls as logical) =>
        let
            argument = ast[Arguments]{0}
        in
            if argument[Kind] = "FieldAccess" then
                [
                    Nullable = true,
                    AddOneIfNull = false,
                    ArgumentAst = ArgumentAuto(if countNulls then one else visitor(argument))
                ]
            else if argument[Kind] = "Invocation" then
                let
                    invocation = argument,
                    argumentForInvocation = @GetCountArgument(invocation, visitor, false)
                in
                    if invocation[Function][Value]? = List.Distinct and GetListCount(invocation[Arguments]) = 1 then
                        [
                            Nullable = true,
                            AddOneIfNull = countNulls and argumentForInvocation[Nullable],
                            ArgumentAst = ArgumentAuto(InvocationWithType({ argumentForInvocation[ArgumentAst] }, "DISTINCT", integerTypeWithFacets))
                        ]
                    else if invocation[Function][Value]? = List.Select and GetListCount(invocation[Arguments]) = 2
 and IsEachNotNullRowExpression(invocation[Arguments]{1}[Value]?) then
                            argumentForInvocation & [
                                Nullable = false,
                                AddOneIfNull = false
                            ]
                    else if (invocation[Function][Value] = ItemExpression.Item[Function][Value]) then
                            // For Table.RowCount; in the original C# code, this corresponds to QueryExpressionKind.ArgumentAccess
                        [
                            Nullable = true,
                            AddOneIfNull = false,
                            ArgumentAst = ArgumentWithType(one, integerTypeWithFacets)
                        ]
                    else
                        error "Unsupported invocation function for GetArgumentForListCount"
            else 
                error "Unsupported argument for GetArgumentForListCount",

    ListCountHelper = (visitor, ast) =>
        let
            foldedArg = visitor(ast[Arguments]{0}[Arguments]{0}),
            arg = GetCountArgument(ast, visitor, true),
            withCount = InvocationWithType({ arg[ArgumentAst] }, "Count", integerTypeWithFacets)
        in
            if arg[AddOneIfNull] then
                let
                    whencondition = UnaryLogicalOperation("IsNull", foldedArg),
                    whenItem = WhenItem(whencondition, one, Number.Type),
                    case = CaseFunction({whenItem},zero,null,Number.Type),
                    max = InvocationWithType({ArgumentWithType(case,integerTypeWithFacets)},"max",integerTypeWithFacets),
                    result =  BinaryOperationWithType(withCount, "Add", max, bigIntTypeWithFacets)
                in
                    result
            else
                withCount,

    IsEachNotNullRowExpression = (func) =>
        let
            //Mashup engine doesn't represent "each _ <> null" as a normal ast, it is just <function>
            //By converting into RowExpression we are able to get a litle more ast info,
            //but "each _" will still be just <function>
            rowexpr = RowExpression.From(func),
            IsNullLiteral = (expr) => expr[Kind] = "Constant" and expr[Value] = null,
            //This is best effort to determine a "each _ " or "(t) => t"
            IsIdentity = (expr) => (expr[Kind] = "Invocation" and GetListCount(expr[Arguments]) = 0 and
                expr[Function][Kind] = "Constant" and expr[Function][Value] is function)
        in
            if rowexpr[Kind] = "Binary" and rowexpr[Operator] = "NotEquals" then
                IsIdentity(rowexpr[Left]) and IsNullLiteral(rowexpr[Right]) or
                IsNullLiteral(rowexpr[Left]) and IsIdentity(rowexpr[Right])
            else
                false,


// This is helper function which is used in dates override function. Please see below for usage
    GetListCount = (listvalue) => List.Count(listvalue),
    GetListContains = (listvalue, elem) => List.Contains(listvalue, elem),
    IsFunctionWithArgs = (ast, func, argsNum) => (
        ast[Kind] = "Invocation" and ast[Function][Kind] = "Constant" and
        ast[Function][Value] = func and GetListCount(ast[Arguments]) = argsNum),

    // DATE values keep the historical AD anchor. TIMESTAMP values use DATE_TRUNC instead of
    // anchor arithmetic because Dremio timestamps cannot represent year 0001, and anchors after
    // the input timestamp produce incorrect negative TIMESTAMPDIFF results.
    StartOfAdDate = LiteralWithType("{d '0001-01-01'}", datetypewithFacets),

    DateTrunc = (datetimePart, sqlAstArg) =>
        InvocationWithType(
            CreateArguments({SqlConstant("AnsiString", datetimePart, textTypeWithFacets), sqlAstArg}),
            "DATE_TRUNC",
            sqlAstArg[Type]),

    DateTimeStartOfExpression = (sqlAstArg, datetimePart, funcName) =>
        if Type.Is(sqlAstArg[Type], type nullable date) then
            let
                datetimePartLiteral = LiteralText(datetimePart),
                numberOfDatetimeParts = InvocationWithInt64(CreateArguments({datetimePartLiteral, StartOfAdDate, sqlAstArg}), "TIMESTAMPDIFF")
            in
                InvocationWithType(CreateArguments({datetimePartLiteral, numberOfDatetimeParts, StartOfAdDate}), "TIMESTAMPADD", StartOfAdDate[Type])
        else if Type.Is(sqlAstArg[Type], type nullable datetime) then
            DateTrunc(datetimePart, sqlAstArg)
        else
            error "Unsupported type for " & funcName,

    DateTimeStartOfHelper = (args, visitor, datetimePart) =>
        let
            sqlAstArg = visitor(args{0}),
            startTime = DateTimeStartOfExpression(sqlAstArg, datetimePart, "Date.StartOf" & datetimePart)
        in
            startTime,

    DateTimeEndOfHelper = (args, visitor, datetimePart) =>
        let
            sqlAstArg = visitor(args{0}),
            datetimePartLiteral = LiteralText(datetimePart),
            dateResult =
                let
                    numberOfDatetimeParts = InvocationWithType(CreateArguments({datetimePartLiteral, StartOfAdDate, sqlAstArg}), "TIMESTAMPDIFF", bigIntTypeWithFacets),
                    plusOneNumberOfDatetimeParts = BinaryOperationWithType(numberOfDatetimeParts, "Add", one, bigIntTypeWithFacets),
                    nextIntervalStart = InvocationWithType(
                        CreateArguments({datetimePartLiteral, plusOneNumberOfDatetimeParts, StartOfAdDate}), "TIMESTAMPADD", StartOfAdDate[Type])
                in
                    InvocationWithType(CreateArguments({LiteralText("DAY"), minusone, nextIntervalStart}), "TIMESTAMPADD", nextIntervalStart[Type]),
            datetimeResult =
                let
                    startTime = DateTimeStartOfExpression(sqlAstArg, datetimePart, "Date.EndOf" & datetimePart),
                    nextIntervalStart = InvocationWithType(
                        CreateArguments({datetimePartLiteral, one, startTime}), "TIMESTAMPADD", startTime[Type]),
                    millisecondInterval = LiteralWithType(FormatFractionalMillisecondIntervalLiteral(1), durationTypeWithFacets)
                in
                    BinaryOperationWithType(nextIntervalStart, "Subtract", millisecondInterval, nextIntervalStart[Type])
        in
            if Type.Is(sqlAstArg[Type], type nullable date) then
                dateResult
            else if Type.Is(sqlAstArg[Type], type nullable datetime) then
                datetimeResult
            else
                error "Unsupported type for Date.EndOf" & datetimePart,

    DateAddHelper = (args, visitor, datetimePart) =>
        let
            sqlAstArgs = List.Transform(args, (c) => visitor(c)),
            datetimePartLiteral = LiteralText(datetimePart)
        in
            InvocationWithType(CreateArguments({datetimePartLiteral, sqlAstArgs{1}, sqlAstArgs{0}}), "TIMESTAMPADD", sqlAstArgs{0}[Type]),

    DateTimeStartOfFactory = (func, timePartName) =>
        (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, func, 1) then
                DateTimeStartOfHelper(ast[Arguments], visitor, timePartName)
            else
                error Text.Format("Invalid usage of Date.StartOf{0}", timePartName),

    DateTimeEndOfFactory = (func, timePartName) =>
        (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, func, 1) then
                DateTimeEndOfHelper(ast[Arguments], visitor, timePartName)
            else
                error Text.Format("Invalid usage of Date.EndOf{0}", timePartName),

    DateAddFactory = (func, timePartName) =>
        (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, func, 2) then
                DateAddHelper(ast[Arguments], visitor, timePartName)
            else
                error Text.Format("Invalid usage of Date.Add{0}", timePartName),

    NumberRoundFactory = (func, functionName) =>
        (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, func, 1) or IsFunctionWithArgs(ast, func, 2) then
                let
                    sqlAstArg = NumberArgumentAsDouble(visitor, ast[Arguments]{0}),
                    args =
                        if GetListCount(ast[Arguments]) = 1 then
                            {ArgumentAuto(sqlAstArg)}
                        else
                            {
                                ArgumentAuto(sqlAstArg),
                                ArgumentAuto(CastSqlExpression(visitor(ast[Arguments]{1}), integerTypeWithFacets))
                            }
                in
                    InvocationWithType(args, functionName, doubleTypeWithFacets)
            else
                error "Invalid usage of " & functionName,

    AggregateFactory = (func, funcName, canTakeTwoArgs, aggName, optional resultType, optional allowNonNumeric as nullable logical) =>
        (visitor, rowType, groupKeys, ast) =>
            if (IsFunctionWithArgs(ast, func, 1) or (canTakeTwoArgs and IsFunctionWithArgs(ast, func, 2))) and groupKeys <> null then
                let
                    sqlAstArg = visitor(ast[Arguments]{0}),
                    isSupportedType = (allowNonNumeric ?? false) or Type.Is(sqlAstArg[Type], type number)
                in
                    if isSupportedType then
                        if resultType <> null then
                            InvocationWithType({ArgumentAuto(sqlAstArg)}, aggName, resultType)
                        else
                            InvocationWithFirstType({ArgumentAuto(sqlAstArg)}, aggName)
                    else
                        error Text.Format("#{0} is not supported for #{1}", {sqlAstArg[Type], funcName})
            else
                error "Invalid usage of " & funcName,

    NumberArgumentAsDouble = (visitor as function, arg as record) as record =>
        let
            sqlAstArg = visitor(arg),
            nativeTypeName = try Type.Facets(sqlAstArg[Type])[NativeTypeName] otherwise null
        in
            if List.Contains({DT_DOUBLE, DT_FLOAT}, nativeTypeName) then
                sqlAstArg
            else
                CastSqlExpression(sqlAstArg, doubleTypeWithFacets),

    NumberUnaryFactory = (func, functionName) =>
        (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, func, 1) then
                InvocationWithType({ArgumentAuto(NumberArgumentAsDouble(visitor, ast[Arguments]{0}))}, functionName, doubleTypeWithFacets)
            else
                error "Invalid usage of " & functionName,

    NumberBinaryFactory = (func, functionName) =>
        (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, func, 2) then
                InvocationWithType(
                    {
                        ArgumentAuto(NumberArgumentAsDouble(visitor, ast[Arguments]{0})),
                        ArgumentAuto(NumberArgumentAsDouble(visitor, ast[Arguments]{1}))
                    },
                    functionName,
                    doubleTypeWithFacets)
            else
                error "Invalid usage of " & functionName,

    NumberLog = (visitor, rowType, groupKeys, ast) =>
        if IsFunctionWithArgs(ast, Number.Log, 1) then
            InvocationWithType({ArgumentAuto(NumberArgumentAsDouble(visitor, ast[Arguments]{0}))}, "LN", doubleTypeWithFacets)
        else if IsFunctionWithArgs(ast, Number.Log, 2) then
            let
                valueLog = InvocationWithType({ArgumentAuto(NumberArgumentAsDouble(visitor, ast[Arguments]{0}))}, "LN", doubleTypeWithFacets),
                baseLog = InvocationWithType({ArgumentAuto(NumberArgumentAsDouble(visitor, ast[Arguments]{1}))}, "LN", doubleTypeWithFacets)
            in
                BinaryOperationWithType(valueLog, "Divide", baseLog, doubleTypeWithFacets)
        else
            error "Invalid usage of Number.Log",

    NumberLog10 = (visitor, rowType, groupKeys, ast) =>
        if IsFunctionWithArgs(ast, Number.Log10, 1) then
            let
                valueLog = InvocationWithType({ArgumentAuto(NumberArgumentAsDouble(visitor, ast[Arguments]{0}))}, "LN", doubleTypeWithFacets),
                tenLog = InvocationWithType({ArgumentAuto(LiteralWithType("10", doubleTypeWithFacets))}, "LN", doubleTypeWithFacets)
            in
                BinaryOperationWithType(valueLog, "Divide", tenLog, doubleTypeWithFacets)
        else
            error "Invalid usage of Number.Log10",

    NumberRoundTowardFactory = (func, functionName) =>
        (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, func, 1) or IsFunctionWithArgs(ast, func, 2) then
                let
                    value = NumberArgumentAsDouble(visitor, ast[Arguments]{0}),
                    rounded =
                        if GetListCount(ast[Arguments]) = 1 then
                            InvocationWithType({ArgumentAuto(value)}, functionName, doubleTypeWithFacets)
                        else
                            let
                                digits = CastSqlExpression(visitor(ast[Arguments]{1}), integerTypeWithFacets),
                                scale = InvocationWithType(CreateArguments({LiteralWithType("10", integerTypeWithFacets), digits}), "POWER", doubleTypeWithFacets),
                                scaled = BinaryOperationWithType(value, "Multiply", scale, doubleTypeWithFacets),
                                roundedScaled = InvocationWithType({ArgumentAuto(scaled)}, functionName, doubleTypeWithFacets)
                            in
                                BinaryOperationWithType(roundedScaled, "Divide", scale, doubleTypeWithFacets)
                in
                    rounded
            else
                error "Invalid usage of " & functionName,

    ValueArithmeticFactory = (func, operator, functionName) =>
        (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, func, 2) or IsFunctionWithArgs(ast, func, 3) then
                BinaryOperationWithType(
                    NumberArgumentAsDouble(visitor, ast[Arguments]{0}),
                    operator,
                    NumberArgumentAsDouble(visitor, ast[Arguments]{1}),
                    doubleTypeWithFacets)
            else
                error "Invalid usage of " & functionName,

    ValueCompare = (visitor, rowType, groupKeys, ast) =>
        if IsFunctionWithArgs(ast, Value.Compare, 2) or IsFunctionWithArgs(ast, Value.Compare, 3) then
            let
                left = NumberArgumentAsDouble(visitor, ast[Arguments]{0}),
                right = NumberArgumentAsDouble(visitor, ast[Arguments]{1}),
                lessThan = WhenItem(BinaryLogicalOperation("LessThan", left, right), minusone, integerTypeWithFacets),
                greaterThan = WhenItem(BinaryLogicalOperation("GreaterThan", left, right), one, integerTypeWithFacets)
            in
                CaseFunction({lessThan, greaterThan}, zero, null, integerTypeWithFacets)
        else
            error "Invalid usage of Value.Compare",

//NativeTypesWithFacets ---This is specific to datasource and should be provided by connector
    textTypeWithFacets = Type.ReplaceFacets(Text.Type,[NativeTypeName = DT_CHARACTER_VARYING]),
    uuidTypeWithFacets = Type.ReplaceFacets(Guid.Type, [NativeTypeName = DT_UUID]),
    doubleTypeWithFacets = Type.ReplaceFacets(Double.Type,[NativeTypeName = DT_DOUBLE,NumericPrecisionBase = 2,NumericPrecision = 53]),
    decimalTypeWithFacets = Type.ReplaceFacets(Decimal.Type, [NativeTypeName = DT_DECIMAL]),
    decimalCastTypeWithFacets = Type.ReplaceFacets(Decimal.Type, [NativeTypeName = DT_DECIMAL_CAST]),
    integerTypeWithFacets = Type.ReplaceFacets(Number.Type, [NativeTypeName = DT_INTEGER]),
    bigIntTypeWithFacets = Type.ReplaceFacets(Number.Type,[NativeTypeName = DT_BIGINT]),
    durationTypeWithFacets = Type.ReplaceFacets(Duration.Type,[NativeTypeName = DT_BIGINT]),
    datetypewithFacets = Type.ReplaceFacets(Date.Type,[NativeTypeName = DT_DATE]),
    datetimeTypeWithFacets = Type.ReplaceFacets(DateTime.Type,[NativeTypeName = DT_TIMESTAMP]),
    timeTypeWithFacets = Type.ReplaceFacets(Time.Type,[NativeTypeName = DT_TIME]),


// Extension library functions
    Extension.LoadExpression = (name as text) =>
       let
           binary = Extension.Contents(name),
           asText = Text.FromBinary(binary)
        in
           Expression.Evaluate(asText, #shared),
    Diagnostics = Extension.LoadExpression("Diagnostics.pqm"),
    Diagnostics.LogValue2 = Diagnostics[LogValue2],
    
    //Adbc Functions Overrides

    // Helper function for UUID comparison handling.
    // Returns null for non-UUID types to fall back to the default implementation,
    // which preserves correct NULL checks and type coercion for all other types.
    HandleCustomTypeComparison = (operator as text, visitor as function, ast as record) =>
        let
            leftArg = ast[Left],
            rightArg = ast[Right],
            left = visitor(leftArg),
            leftNativeType = try Type.Facets(left[Type])[NativeTypeName] otherwise null,
            isLeftUuid = leftNativeType = DT_UUID,
            result =
                if not isLeftUuid then null
                else if rightArg[Kind] = "Constant" and rightArg[Value] = null then null
                else
                    BinaryLogicalOperation(operator, left, CastSqlExpression(visitor(rightArg), uuidTypeWithFacets))
        in
            result,

    AdbcFunctionOverrides = [
    //   Below are the complex function override implementation of some of the functions. All the complex overrides gets same input arguments
    //   which can be used as helper to create Sql Ast equivalent for the Function that is being overridden
    //   Input Arguments :
    //        visitor :            This is a helper function which takes any M Query expression and returns its equivalent Sql Ast.
    //                             This is used where details of the M query expression is not known (like arguments for the function) but it needs to be converted to Sql Ast.
    //        rowType :            This provides rowtype record for the arguments of Invocation
    //        groupKeys :          This is for future use as of now.
    //        ast       :          This is M query expression that needs to be converted to Sql Expression
    // Note : All the types assigned to Sql Ast needs to have correct Facets information added to it to avoid any failures.
    // Note : SQLEXPR(x) is SQL Ast that has been calculated using helper visitor in below examples
    //----------------------------------------------------------------------------------------------------------------
        Text.Middle = (visitor, rowType, groupKeys, ast) as record =>
            if IsFunctionWithArgs(ast, Text.Middle, 2) or IsFunctionWithArgs(ast, Text.Middle, 3) then
                let
                    textExp = visitor(ast[Arguments]{0}),
                    start = BinaryOperationWithType(
                        CastSqlExpression(visitor(ast[Arguments]{1}), bigIntTypeWithFacets),
                        "Add",
                        one,
                        bigIntTypeWithFacets),
                    substringArgs =
                        if GetListCount(ast[Arguments]) = 2 then
                            CreateArguments({textExp, start})
                        else
                            let
                                length = InvocationWithType(CreateArguments({textExp}), "LENGTH", bigIntTypeWithFacets),
                                // if count is null, lets just use the whole length of an input - Dremio is ok with that
                                count = CastSqlExpression(
                                    InvocationWithType(CreateArguments({visitor(ast[Arguments]{2}), length}), "COALESCE", bigIntTypeWithFacets),
                                    bigIntTypeWithFacets)
                            in
                                CreateArguments({textExp, start, count})
                in
                    InvocationWithType(substringArgs, "SUBSTRING", textTypeWithFacets)
            else
                error "Invalid usage of Text.Middle",

    //----------------------------------------------------------------------------------------------------------------
    //   Example :
    //   M Function ---> Text.From(ColumnName)
    //   M Query Expression ---> [
    //                             Kind = "Invocation",
    //                             Function = [
    //                                          Kind = Constant,
    //                                          value = (ColumnName) => ... //Text.From
    //                                        ],
    //                             Arguments = { [
    //                                             Kind = "Constant",
    //                                             Value = ColumnName
    //                                           ]}
    //                           ]
    //   Sql Ast  --->               [
    //                                 Kind = "Invocation", Function = [Kind = "Function", Name="TO_VARCHAR"],
    //                                 Arguments = {
    //                                               [ Expression = SQLEXPR(ColumnName), Type = type text  (with Facet information added)]
    //                                             },
    //                                 Type = type text
    //                               ]
    //
    //   Sql Expression --->  TO_VARCHAR(ColumnName)

        // In case of Dremio, we are taking the approach to use CAST(ARG AS CHARACTER VARYING) to do the text convertion
        Text.From = (visitor, rowType, groupKeys, ast) =>
            if ast[Kind] = "Invocation" and ast[Function][Kind] = "Constant" and ast[Function][Value] = Text.From and GetListCount(ast[Arguments]) >= 1 and GetListCount(ast[Arguments]) <= 2 then
                let
                    argCount = GetListCount(ast[Arguments]),
                    sqlAstArg = visitor(ast[Arguments]{0}),
                    culture = if argCount = 2 then TryGetAstText(ast[Arguments]{1}) else null,
                    nativeTypeName = try Type.Facets(sqlAstArg[Type])[NativeTypeName] otherwise null,
                    isNotUuid = nativeTypeName <> DT_UUID
                in
                    if argCount = 2 and culture <> "en-US" then
                        error Text.Format("Unsupported culture #{0} for function Text.From", {culture})
                    else if argCount = 2 and IsDateTimeLikeSqlType(sqlAstArg[Type]) then
                        TextFromDateTimeEnUs(sqlAstArg)
                    else if argCount = 2 then
                        error Text.Format("Unsupported type #{0} for culture-aware function Text.From", {sqlAstArg[Type]})
                    else if Type.Is(sqlAstArg[Type], type text) and isNotUuid then
                        sqlAstArg
                    else
                        CastSqlExpression(sqlAstArg, textTypeWithFacets)
            else
                error "Invalid usage of Text.From",
        Text.PositionOf = (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, Text.PositionOf, 2) then
                let
                    sqlAstArgs = List.Transform(ast[Arguments], (c) => visitor(c)),
                    textExp = ArgumentWithType(sqlAstArgs{0}, textTypeWithFacets),
                    substring = ArgumentWithType(sqlAstArgs{1}, textTypeWithFacets),
                    position = InvocationWithInt64({substring, textExp}, "LOCATE"),
                    substringLength = InvocationWithInt64({substring}, funcName[Length]),
                    whenItem = WhenItem(
                        BinaryLogicalOperation("Equals", substringLength, zero),
                        CastSqlExpression(zero, bigIntTypeWithFacets),
                        bigIntTypeWithFacets)
                in
                    CaseFunction(
                        {whenItem},
                        BinaryOperationWithType(position, "Subtract", one, bigIntTypeWithFacets),
                        null,
                        bigIntTypeWithFacets)
            else
                error "Invalid usage of Text.PositionOf",

        Text.Contains = (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, Text.Contains, 2) then
                let
                    sqlAstArgs = List.Transform(ast[Arguments], (c) => visitor(c)),
                    textExp = ArgumentWithType(sqlAstArgs{0}, textTypeWithFacets),
                    substring = ArgumentWithType(sqlAstArgs{1}, textTypeWithFacets),
                    position = InvocationWithInt64({substring, textExp}, "LOCATE")
                in
                    BinaryLogicalOperation("GreaterThan", position, zero)
            else
                error "Invalid usage of Text.Contains",

        Value.Add = ValueArithmeticFactory(Value.Add, "Add", "Value.Add"),
        Value.Subtract = ValueArithmeticFactory(Value.Subtract, "Subtract", "Value.Subtract"),
        Value.Multiply = ValueArithmeticFactory(Value.Multiply, "Multiply", "Value.Multiply"),
        Value.Divide = ValueArithmeticFactory(Value.Divide, "Divide", "Value.Divide"),
        Value.Compare = ValueCompare,

    //----------------------------------------------------------------------------------------------------------------
    //   Example :
    //   M Function ---> Date.StartOfYear(DATECOLUMN)
    //   M Query Expression ---> [
    //                             Kind = "Invocation",
    //                             Function = [
    //                                          Kind = Constant,
    //                                          value = (datetime) => ... //Date.StartOfYear
    //                                        ],
    //                             Arguments = { [
    //                                             Kind = "Constant",
    //                                             Value = DATECOLUMN
    //                                           ]}
    //                           ]
    //   Sql Ast  ---> startDateOfYear = [Kind = "SqlConstant", ConstantType = "AnsiString", Literal = "2000-01-01 00:00:00.000", Type = Type text ]
    //                 TOTIMESTAMP =  [
    //                                 Kind = "Invocation", Function = [Kind = "Function", Name="TO_TIMESTAMP"],
    //                                 Arguments = {
    //                                               [ Expression = startDateOfYear, Type = type text  (with Facet information added)]
    //                                             },
    //                                 Type = Int64.Type
    //                               ]
    //                 timestampdiff = [  Kind = "Invocation", Function = [Kind = "Function", Name = "timestampdiff"],
    //                                    Arguments = {
    //                                                  [Expression = [Kind = "Literal", Value = "year"], Type = null],
    //                                                  [Expression = TOTIMESTAMP, Type = null],
    //                                                  [Expression = SQLEXPR(DATECOLUMN),Type = null]
    //                                                },
    //                                    Type = Int64.Type
    //                                 ],
    //   This is the final result sql AST representation for M query expression
    //                 sqlAstforDateStartOfYear =  [  Kind = "Invocation", Function = [Kind = "Function", Name = "timestampadd"],
    //                                                Arguments = {
    //                                                              [Expression =  [Kind = "Literal", Value = "year"], Type = null],
    //                                                              [Expression = timestampdiff, Type = null],
    //                                                              [Expression = TOTIMESTAMP,Type = null]
    //                                                           },
    //                                                Type = Int64.Type
    //                                             ],
    //
    //   Sql Expression --->  timestampadd(year, timestampdiff(year, TO_TIMESTAMP('2000-01-01 00:00:00.000'), "DATECOL"), TO_TIMESTAMP('2000-01-01 00:00:00.000'))

        Date.StartOfYear = DateTimeStartOfFactory(Date.StartOfYear, "YEAR"),
        Date.StartOfQuarter = DateTimeStartOfFactory(Date.StartOfQuarter, "QUARTER"),
        Date.StartOfMonth = DateTimeStartOfFactory(Date.StartOfMonth, "MONTH"),
        Date.StartOfDay = DateTimeStartOfFactory(Date.StartOfDay, "DAY"),
        Date.StartOfWeek = DateTimeStartOfFactory(Date.StartOfWeek, "WEEK"),

        Date.EndOfYear = DateTimeEndOfFactory(Date.EndOfYear, "YEAR"),
        Date.EndOfQuarter = DateTimeEndOfFactory(Date.EndOfQuarter, "QUARTER"),
        Date.EndOfMonth = DateTimeEndOfFactory(Date.EndOfMonth, "MONTH"),
        Date.EndOfWeek = DateTimeEndOfFactory(Date.EndOfWeek, "WEEK"),
        Date.EndOfDay = DateTimeEndOfFactory(Date.EndOfDay, "DAY"),

        Date.AddYears = DateAddFactory(Date.AddYears, "YEAR"),
        Date.AddQuarters = DateAddFactory(Date.AddQuarters, "QUARTER"),
        Date.AddMonths = DateAddFactory(Date.AddMonths, "MONTH"),
        Date.AddWeeks = DateAddFactory(Date.AddWeeks, "WEEK"),
        Date.AddDays = DateAddFactory(Date.AddDays, "DAY"),

        Time.EndOfHour = DateTimeEndOfFactory(Time.EndOfHour, "HOUR"),
        Time.StartOfHour = DateTimeStartOfFactory(Time.StartOfHour, "HOUR"),

        List.Contains = (visitor, rowType, groupKeys, ast) =>
            if ast[Kind] = "Invocation" and ast[Function][Kind] = "Constant" and ast[Function][Value] = List.Contains and  GetListCount(ast[Arguments]) = 2 then
                let
                    arg1 = ast[Arguments]{0},
                    sqlastarg2 = visitor(ast[Arguments]{1}),
                    columnNativeType = try Type.Facets(sqlastarg2[Type])[NativeTypeName] otherwise null,
                    isUuidColumn = columnNativeType = DT_UUID,
                    uuidSingleElement =
                        let
                            elementValue = arg1[Value]{0}
                        in
                            if elementValue = null then UnaryLogicalOperation("IsNull", sqlastarg2)
                            else BinaryLogicalOperation("Equals", sqlastarg2,
                                CastSqlExpression(visitor([Kind = "Constant", Value = elementValue, Type = arg1[Type]]), uuidTypeWithFacets)),
                    uuidInExpression =
                        let
                            array = List.Transform(arg1[Value], (c) => [Kind = "Constant", Value = c, Type = arg1[Type]]),
                            sqlastarg1 = List.Transform(array, (c) =>
                                if c[Value] <> null then CastSqlExpression(visitor(c), uuidTypeWithFacets)
                                else visitor(c))
                        in
                            BinaryLogicalOperation("In", sqlastarg2, InArrayExpression(sqlastarg1)),
                    result = if(arg1[Kind] = "Constant" and Type.Is(Value.Type(arg1[Value]),type list))
                        then
                            if(GetListCount(arg1[Value]) = 1) then
                                if isUuidColumn then uuidSingleElement
                                else SingleListElement(ast,visitor)
                            else
                                if isUuidColumn then uuidInExpression
                                else InExpression(ast[Arguments],visitor)
                        else ...
                 in
                    result
            else ...,

        Int64.From = IntFromFactory(Int64.From, bigIntTypeWithFacets),
        Int32.From = IntFromFactory(Int32.From, integerTypeWithFacets),
        Int16.From = IntFromFactory(Int16.From, integerTypeWithFacets),
        Int8.From = IntFromFactory(Int8.From, integerTypeWithFacets),
        Decimal.From = NumberFromFactory(Decimal.From, decimalCastTypeWithFacets),
        Double.From = NumberFromFactory(Double.From, doubleTypeWithFacets),
        Guid.From = (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, Guid.From, 1) then
                let
                    sqlAstArg = visitor(ast[Arguments]{0})
                in
                    if Type.Is(sqlAstArg[Type], type text) or Type.Is(sqlAstArg[Type], type binary) then
                        CastSqlExpression(sqlAstArg, uuidTypeWithFacets)
                    else
                        error Text.Format("Unsupported type #{0} for function Guid.From", {sqlAstArg[Type]})
            else
                error "Invalid usage of Guid.From",
        Logical.From = (visitor, rowType, groupKeys, ast) =>
            if ast[Kind] = "Invocation" and ast[Function][Kind] = "Constant" and ast[Function][Value] = Logical.From and  GetListCount(ast[Arguments]) = 1 then
                let
                    sqlastarg = visitor(ast[Arguments]{0}),
                    truestring = SqlConstant("AnsiString", "true", textTypeWithFacets),
                    result = if(Type.Is(sqlastarg[Type], type nullable logical)) then
                            sqlastarg
                        else if(Type.Is(sqlastarg[Type], type nullable number)) then
                            BinaryLogicalOperation("NotEqualTo", sqlastarg, zero)
                        else if(Type.Is(sqlastarg[Type], type nullable text)) then
                            let
                                castExpr = CastSqlExpression(sqlastarg, textTypeWithFacets),
                                lowerInvocation = InvocationWithType({ArgumentAuto(castExpr)}, "LOWER", textTypeWithFacets)
                            in
                                BinaryLogicalOperation("Equals", lowerInvocation, truestring)
                        else error Text.Format("#{0} is not supported for function Logical.From", {sqlastarg[Type]})
                 in
                    result
            else error "Invalid usage of Logical.From",

        DateTime.From = (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, DateTime.From, 1) then
                let
                    sqlAstArg = visitor(ast[Arguments]{0}),
                    // Power Bi specifies that the OLE Automation Day 0 (1899-12-30)
                    // should be used as the base in case of converting from number of days or if we are just given only time
                    oleAutomationDate0 = CastSqlExpression(OleAutomationDateSqlConst, datetypewithFacets)
                in
                    if Type.Is(sqlAstArg[Type], type nullable text) or Type.Is(sqlAstArg[Type], type nullable date) then
                        // Technicaly there is enormous ways to specify a datetime format for text conversion in Power BI
                        // there is no possebility to cover all of them, so we just use CAST as a most flexible and simple one
                        // and the one which works by design with text representation obtained by Dremio from original datetimes
                        CastSqlExpression(sqlAstArg, datetimeTypeWithFacets)
                    else if Type.Is(sqlAstArg[Type], type nullable time) then
                        let
                            // Dremio casts time to the datetime at day 0 of Unix epoch
                            timeAtUnixDay0 = CastSqlExpression(sqlAstArg, datetimeTypeWithFacets),
                            daysBetweenUnixAndOleAutomation = LiteralWithType("-25569", bigIntTypeWithFacets)
                        in
                            InvocationWithType(CreateArguments({LiteralText("DAY"), daysBetweenUnixAndOleAutomation, timeAtUnixDay0}), "TIMESTAMPADD", datetimeTypeWithFacets)
                    else if Type.Is(sqlAstArg[Type], type nullable number) then
                        let
                            secondsInDay = LiteralWithType("86400", bigIntTypeWithFacets),
                            daysAsDouble = CastSqlExpression(sqlAstArg, doubleTypeWithFacets),
                            secondsFromDays = CastSqlExpression(BinaryOperationWithType(daysAsDouble, "Multiply", secondsInDay, doubleTypeWithFacets), bigIntTypeWithFacets)
                        in
                            InvocationWithType(CreateArguments({LiteralText("SECOND"), secondsFromDays, oleAutomationDate0}), "TIMESTAMPADD", datetimeTypeWithFacets)
                    else if Type.Is(sqlAstArg[Type], type nullable datetime) then
                        sqlAstArg
                    else
                        error Text.Format("Unsupported type #{0} for function DateTime.From", {sqlAstArg[Type]})
            else error "Invalid usage of DateTime.From",

        Date.From = (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, Date.From, 1) then
                let
                    sqlAstArg = visitor(ast[Arguments]{0})
                in
                    if Type.Is(sqlAstArg[Type], type nullable text) or Type.Is(sqlAstArg[Type], type nullable datetime) then
                        CastSqlExpression(sqlAstArg, datetypewithFacets)
                    else if Type.Is(sqlAstArg[Type], type nullable number) then
                        let
                            daysFloored = InvocationWithInt64({ArgumentWithType(sqlAstArg, doubleTypeWithFacets)}, "FLOOR"),
                            daysAsInteger = CastSqlExpression(daysFloored, bigIntTypeWithFacets),
                            oleAutomationDate0 = CastSqlExpression(OleAutomationDateSqlConst, datetypewithFacets)
                        in
                            InvocationWithType(CreateArguments({LiteralText("DAY"), daysAsInteger, oleAutomationDate0}), "TIMESTAMPADD", datetypewithFacets)
                    else if Type.Is(sqlAstArg[Type], type nullable date) then
                        sqlAstArg
                    else
                        error Text.Format("Unsupported type #{0} for function Date.From", {sqlAstArg[Type]})
            else
                error "Invalid usage of Date.From",

        Table.ApproximateRowCount = (visitor, rowType, groupKeys, ast) as record =>
            let
                Function = (name) => [Kind = "Function", Name=name],
                Argument = (expr) => [Expression = expr, Type = null],
                ApproxDistinctCount = (list) => [
                    Kind = "Invocation",
                    Function = Function("approx_count_distinct"),
                    Arguments = List.Transform(list, Argument), Type = Int64.Type
                ],
                GetInvocation = (ast, function, count) =>
                    if ast[Kind] = "Invocation" and ast[Function][Kind] = "Constant" and ast[Function][Value] = function and GetListCount(ast[Arguments]) = count
                    then ast[Arguments]
                    else ...,
                tarc = GetInvocation(ast, Table.ApproximateRowCount, 1),
                td = GetInvocation(tarc{0}, Table.Distinct, 1),
                sc = GetInvocation(td{0}, Table.SelectColumns, 2)
             in
                if groupKeys <> null and sc{0} = RowExpression.Row and sc{1}[Value]? is list then
                ApproxDistinctCount(List.Transform(sc{1}[Value], (c) => visitor(RowExpression.Column(c))))
                else ...,

    // Aggregate functions

        Number.Abs = NumberUnaryFactory(Number.Abs, "ABS"),
        Number.Acos = NumberUnaryFactory(Number.Acos, "ACOS"),
        Number.Asin = NumberUnaryFactory(Number.Asin, "ASIN"),
        Number.Atan = NumberUnaryFactory(Number.Atan, "ATAN"),
        Number.Atan2 = NumberBinaryFactory(Number.Atan2, "ATAN2"),
        Number.Cos = NumberUnaryFactory(Number.Cos, "COS"),
        Number.Exp = NumberUnaryFactory(Number.Exp, "EXP"),
        Number.Log = NumberLog,
        Number.Log10 = NumberLog10,
        Number.Power = NumberBinaryFactory(Number.Power, "POWER"),
        Number.Sign = NumberUnaryFactory(Number.Sign, "SIGN"),
        Number.Sin = NumberUnaryFactory(Number.Sin, "SIN"),
        Number.Sqrt = NumberUnaryFactory(Number.Sqrt, "SQRT"),
        Number.Tan = NumberUnaryFactory(Number.Tan, "TAN"),
        Number.Round = NumberRoundFactory(Number.Round, "round"),
        Number.RoundUp = NumberRoundTowardFactory(Number.RoundUp, "ceil"),
        Number.RoundDown = NumberRoundTowardFactory(Number.RoundDown, "floor"),
        List.Sum = AggregateFactory(List.Sum, "List.Sum", true, "SUM"),
        List.Average = AggregateFactory(List.Average, "List.Average", true, "AVG", doubleTypeWithFacets),
        List.Max = AggregateFactory(List.Max, "List.Max", false, "MAX", null, true),
        List.Min = AggregateFactory(List.Min, "List.Min", false, "MIN", null, true),
        List.StandardDeviation = AggregateFactory(List.StandardDeviation, "List.StandardDeviation", false, "STDDEV_SAMP", doubleTypeWithFacets),

        List.Count = (visitor, rowType, groupKeys, ast) =>
            if GetListCount(ast[Arguments]) = 1 and groupKeys <> null then 
                ListCountHelper(visitor, ast)
            else
                error "Invalid usage of List.Count",

        // Enables PBI relationships. Only works with UseAdbcConnections=true
        Table.RowCount = (visitor, rowType, groupKeys, ast) =>
            if GetListCount(ast[Arguments]) = 1 and groupKeys <> null then 
                ListCountHelper(visitor, ast)
            else
                error "Invalid usage of Table.RowCount",

        Number.Mod = (visitor, rowType, groupKeys, ast) =>
            if IsFunctionWithArgs(ast, Number.Mod, 2) then
                let
                    leftArg = visitor(ast[Arguments]{0}),
                    rightArg = visitor(ast[Arguments]{1}),
                    nonIntegerTypes = {Double.Type, Single.Type, Decimal.Type},
                    Type =
                        if GetListContains(nonIntegerTypes, leftArg[Type]) or GetListContains(nonIntegerTypes, rightArg[Type]) then
                        //Dremio produces decimals if any argument is not integer
                            decimalTypeWithFacets
                        else //otherwise it is integer type of seconds arg
                            rightArg[Type]
                in
                    InvocationWithType(CreateArguments({leftArg, rightArg}), "MOD", Type)
            else
                error "Invalid usage of Number.Mod"

    ]
  in
    [
        SqlGenerator = SqlGenerator & addToAstVisitor,
        TypeFacets = TypeFacets
    ]
